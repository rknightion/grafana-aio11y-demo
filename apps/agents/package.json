{
  "name": "@touchline/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Touchline Times in-app multi-agent service (orchestrator + news, odds, editorial, compliance specialists) on Amazon Bedrock, plus the load generator and the experiment runner.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import ./src/instrumentation.mjs src/server.mjs",
    "loadgen": "AGENT_ROLE=loadgen node --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import ./src/instrumentation.mjs src/server.mjs",
    "experiment": "node experiments/run-experiment.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/client-bedrock-runtime": "3.883.0",
    "@aws-sdk/credential-provider-node": "3.883.0",
    "@grafana/agento11y": "0.13.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.7.0",
    "@opentelemetry/core": "2.7.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.214.0",
    "@opentelemetry/instrumentation": "0.214.0",
    "@opentelemetry/instrumentation-http": "0.214.0",
    "@opentelemetry/instrumentation-undici": "0.32.0",
    "@opentelemetry/resources": "2.7.0",
    "@opentelemetry/sdk-metrics": "2.7.0",
    "@opentelemetry/sdk-trace-base": "2.7.0",
    "@opentelemetry/sdk-trace-node": "2.7.0",
    "@smithy/protocol-http": "5.2.0",
    "@smithy/signature-v4": "5.2.0",
    "@touchline/mcp-tools": "file:../mcp-tools",
    "yaml": "2.8.3"
  },
  "overrides": {
    "fast-xml-parser": "5.11.1"
  }
}
