# syntax=docker/dockerfile:1
# Touchline Times synthetic reader: one headless Chromium session against the site per run
# (a Kubernetes CronJob). Playwright downloads the headless shell for the build architecture.
#   docker buildx build --platform linux/amd64,linux/arm64 -f apps/site/Dockerfile.browser apps
FROM node:24-bookworm-slim
ENV NODE_ENV=production PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app
# Take Debian security fixes the base image has not been rebuilt with yet (Trivy gates the build).
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*
COPY site/package.json site/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
 && npx playwright install --with-deps --only-shell chromium \
 && rm -rf node_modules/@opentelemetry node_modules/@grafana \
 && npm cache clean --force \
 && rm -rf /var/lib/apt/lists/* \
 && chmod -R a+rX /ms-playwright \
 # npm/npx/corepack are unused after this point (the CMD is plain node); drop the base image's
 # bundled npm CLI so its own vulnerable transitive deps (pacote, sigstore, picomatch, ...) never
 # ship in the image.
 && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
# Mirror the apps/ layout (site/, corpus/, mcp-tools/ as siblings under /app), because
# browser.mjs resolves the reader corpus and the fixture data by relative path
# (../../corpus/readers.mjs and ../../mcp-tools/src/data/fixtures.json from site/src/).
COPY site/src/browser.mjs site/src/config.mjs ./site/src/
COPY corpus ./corpus
COPY mcp-tools/src/data/fixtures.json ./mcp-tools/src/data/fixtures.json
USER node
CMD ["node", "site/src/browser.mjs"]
