#!/bin/bash
# Docker compose v2 plugin, pinned and checksum-verified (AL2023 ships Docker without it).
set -Eeuo pipefail
version=v5.5.1
case "$(uname -m)" in
  aarch64) arch=aarch64; sum=732e3a84c1a0f67256ce80bc2598a24546b10ca05f9faa97efceb1171ece2ef7 ;;
  x86_64) arch=x86_64; sum=db1889184726840f75c4f9c001048430d4f25b3be3cb084d3ddd762bc0aed576 ;;
  *) echo "unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac
dest=/usr/local/lib/docker/cli-plugins/docker-compose
if [[ -x "$dest" ]] && echo "$sum  $dest" | sha256sum -c --status; then exit 0; fi
mkdir -p "$(dirname "$dest")"
curl -fsSL --retry 5 --retry-all-errors \
  "https://github.com/docker/compose/releases/download/$version/docker-compose-linux-$arch" -o "$dest.tmp"
echo "$sum  $dest.tmp" | sha256sum -c
chmod 0755 "$dest.tmp"
mv "$dest.tmp" "$dest"
