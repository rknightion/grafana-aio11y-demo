#!/usr/bin/env bash
# Seeds <dest> (an existing empty directory) as a git repository containing the fictional
# Touchline Times codebase, with a realistic multi-author, backdated commit history ending on a
# clean main. Deterministic and offline: two runs against two empty destinations produce the same
# tree hash. Source files live under agent-host/codebase/tree/ next to this script.
set -Eeuo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: seed-repo <dest>" >&2
  exit 2
fi

dest=$1
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
src="$script_dir/tree"

if [[ ! -d "$src" ]]; then
  echo "seed-repo: source tree not found at $src" >&2
  exit 1
fi
if [[ ! -d "$dest" ]]; then
  echo "seed-repo: dest '$dest' does not exist" >&2
  exit 1
fi
if [[ -n "$(ls -A "$dest" 2>/dev/null)" ]]; then
  echo "seed-repo: dest '$dest' is not empty" >&2
  exit 1
fi

# Never let the host's or a developer's own git config leak into the fictional history.
export GIT_CONFIG_GLOBAL=/dev/null
export GIT_CONFIG_NOSYSTEM=1
export GIT_ATTR_NOSYSTEM=1

git -C "$dest" init --quiet --initial-branch=main

commit() {
  local date=$1 name=$2 email=$3 message=$4
  shift 4
  local rel to
  for rel in "$@"; do
    to="$dest/$rel"
    mkdir -p "$(dirname "$to")"
    cp "$src/$rel" "$to"
  done
  git -C "$dest" -c user.name="$name" -c user.email="$email" add -- "$@"
  GIT_AUTHOR_DATE="$date" GIT_COMMITTER_DATE="$date" \
    git -C "$dest" -c user.name="$name" -c user.email="$email" \
      commit --quiet --no-gpg-sign -m "$message"
}

