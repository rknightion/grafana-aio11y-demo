#cloud-config
# Agent host bootstrap, rendered by Terraform (terraform/aws-agent-host.tf). user_data is STATIC:
# only the prefix, region, secret ARN, image registry/tag/digests and the render bundle manifest
# (S3 key and SHA-256 of each file under agent-host/ that runs as root: render.py, the host
# scripts, the Alloy and Postgres configs). Credentials and every mutable knob live in the
# agent-host secret (its `config` key); agent-host-up reads it at boot and
# agent-host-refresh.timer re-reads it every 5 minutes.
#
# Nothing that runs as root with the secret comes from a container image, and nothing listens on
# the VPC: the gateway is published on the host loopback only.

package_update: false
packages:
  - docker
  - iptables-nft
  - jq

write_files:
  - path: /etc/agent-host/host.json
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${base64encode(jsonencode({
      name            = name
      aws_region      = aws_region
      secret_arn      = secret_arn
      images_registry = images_registry
      images_tag      = images_tag
      images_digests  = jsondecode(images_digests_json)
    }))}

  - path: /etc/agent-host/bundle.json
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${base64encode(bundle_json)}

  # Installs the render bundle from S3, refusing any file whose SHA-256 differs from bundle.json.
  - path: /usr/local/sbin/agent-host-install-bundle
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      set -Eeuo pipefail
      umask 022
      bucket=${bundle_bucket}
      region=${aws_region}
      tmp=$(mktemp -d)
      trap 'rm -rf -- "$tmp"' EXIT
      jq -r 'to_entries[] | [.key, .value.key, .value.sha256, .value.mode] | @tsv' /etc/agent-host/bundle.json |
        while IFS=$'\t' read -r path key sum mode; do
          for n in $(seq 1 20); do
            aws s3api get-object --region "$region" --bucket "$bucket" --key "$key" "$tmp/f" >/dev/null && break
            echo "agent-host-install-bundle: retry $n for $key" >&2
            sleep 15
          done
          echo "$sum  $tmp/f" | sha256sum -c --quiet
          install -D -o root -g root -m "$mode" "$tmp/f" "$path"
          echo "agent-host-install-bundle: installed $path" >&2
        done

  # Fail closed: Docker (and every container it restarts at boot) starts only after the
  # isolation rules are in place, and they are re-applied once its own chains exist.
  - path: /etc/systemd/system/docker.service.d/agent-host-firewall.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Service]
      ExecStartPre=/usr/local/sbin/agent-host-firewall
      ExecStartPost=/usr/local/sbin/agent-host-firewall

  - path: /etc/systemd/system/agent-host.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Agent host compose project (Claude apps gateway and developer containers)
      Wants=network-online.target
      After=network-online.target docker.service
      Requires=docker.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      # Security updates from the latest AL2023 release at every boot (the AMI is never
      # replaced in place). A failed update does not block the demo; kernels apply on reboot.
      ExecStartPre=-/usr/bin/dnf -y -q upgrade --security --releasever=latest
      ExecStart=/usr/local/sbin/agent-host-up
      ExecStop=/usr/bin/docker compose -f /etc/agent-host/compose.yaml stop
      TimeoutStartSec=2400
      Restart=on-failure
      RestartSec=60

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/agent-host-refresh.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Re-render the agent host when its secret or config changed
      After=agent-host.service
      Requires=docker.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/agent-host-up --refresh
      TimeoutStartSec=1800

  - path: /etc/systemd/system/agent-host-refresh.timer
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Check the agent-host secret for changes every 5 minutes

      [Timer]
      OnBootSec=10min
      OnUnitActiveSec=5min
      RandomizedDelaySec=30s

      [Install]
      WantedBy=timers.target

runcmd:
  - [/usr/local/sbin/agent-host-install-bundle]
  - [systemctl, daemon-reload]
  - [/usr/local/sbin/agent-host-install-compose]
  - [systemctl, enable, --now, docker.service]
  - [systemctl, enable, --now, --no-block, agent-host.service]
  - [systemctl, enable, --now, agent-host-refresh.timer]
