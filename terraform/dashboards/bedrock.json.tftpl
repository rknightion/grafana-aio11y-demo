      "t3-lat": {
        "kind": "Panel",
        "spec": {
          "id": 19,
          "title": "Invocation latency (average) by ModelId",
          "description": "aws_bedrock_invocation_latency_average.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
