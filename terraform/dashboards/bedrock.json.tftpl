                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (dimension_ModelId) (sum_over_time(aws_bedrock_input_token_count_sum[$__interval]))",
                        "range": true,
                        "instant": false,
                        "refId": "A",
                        "legendFormat": "{{dimension_ModelId}} in"
                      }
                    }
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "B",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (dimension_ModelId) (sum_over_time(aws_bedrock_output_token_count_sum[$__interval]))",
                        "range": true,
                        "instant": false,
                        "refId": "B",
                        "legendFormat": "{{dimension_ModelId}} out"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "sum"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
