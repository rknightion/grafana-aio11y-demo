      "ga-config": {
        "kind": "Panel",
        "spec": {
          "id": 193,
          "title": "Gateway config loads",
          "description": "config.load: each gateway.yaml the gateway loaded, by hash. A rollout shows as a new sha256.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
