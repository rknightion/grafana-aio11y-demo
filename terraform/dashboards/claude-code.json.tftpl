                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "100 * sum(count_over_time({service_name=\"claude-code\", service_namespace=\"${prefix}\"} | user_groups=~\"$team\" | user_email=~\"$user\" | session_id=~\"$session\" | event_name=\"tool_result\" | success=\"true\" [$__range])) / sum(count_over_time({service_name=\"claude-code\", service_namespace=\"${prefix}\"} | user_groups=~\"$team\" | user_email=~\"$user\" | session_id=~\"$session\" | event_name=\"tool_result\" [$__range]))",
                        "legendFormat": "",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
