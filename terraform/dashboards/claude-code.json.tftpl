      "ga-events": {
        "kind": "Panel",
        "spec": {
          "id": 185,
          "title": "Audit events over time",
          "description": "Every gateway audit event by type.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (evt) (count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json [$__auto]))",
                        "queryType": "range",
                        "refId": "A",
                        "legendFormat": "{{evt}}"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "sum"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "drawStyle": "bars",
                    "stacking": {
                      "mode": "normal"
                    },
                    "fillOpacity": 80
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-upstream": {
        "kind": "Panel",
        "spec": {
          "id": 186,
          "title": "Upstream split",
          "description": "inference events by upstream route and status.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (upstream, status) (count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=\"inference\" [$__range]))",
                        "queryType": "instant",
                        "refId": "A",
                        "legendFormat": "{{upstream}} {{status}}"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "piechart",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "values": [
                    "value",
                    "percent"
                  ]
                },
                "pieType": "donut",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
