      "gs-devs": {
        "kind": "Panel",
        "spec": {
          "id": 200,
          "title": "Developers metered this month",
          "description": "Principals with a spend row for the current month.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_spend}"
                      },
                      "spec": {
                        "refId": "A",
                        "rawSql": "SELECT COUNT(DISTINCT principal) AS developers FROM spend WHERE period = to_char(now() AT TIME ZONE 'UTC','YYYY-MM')",
                        "format": "table",
                        "rawQuery": true,
                        "editorMode": "code"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "blue"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "gs-caps": {
        "kind": "Panel",
        "spec": {
          "id": 201,
          "title": "Spend caps configured",
          "description": "Rows in spend_limits. 0 means nobody is capped yet.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
