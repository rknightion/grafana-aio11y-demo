                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (model) (count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=\"inference\" [$__auto]))",
                        "queryType": "range",
                        "refId": "A",
                        "legendFormat": "{{model}}"
                      }
                    }
