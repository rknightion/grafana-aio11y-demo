      "ct-tokens-time": {
        "kind": "Panel",
        "spec": {
          "id": 21,
          "title": "Tokens over time by type",
          "description": "New tokens per interval, by token type.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (type)((max_over_time(claude_code_token_usage_tokens_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\"}[$__interval]) - max_over_time(claude_code_token_usage_tokens_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\"}[$__interval] offset $__interval)) or max_over_time(claude_code_token_usage_tokens_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\"}[$__interval]))",
                        "legendFormat": "{{type}}",
                        "range": true,
                        "instant": false,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "5m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "sum"
                  ]
