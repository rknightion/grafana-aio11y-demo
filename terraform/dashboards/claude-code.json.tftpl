      "gb-content": {
        "kind": "Panel",
        "spec": {
          "id": 217,
          "title": "What Claude Code sent to Bedrock",
          "description": "The request the gateway relayed, as the Bedrock invocation log recorded it. Content is visible with no client telemetry, but every developer shares the gateway's IAM role.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "${bedrock_log_selector} | json pid=\"modelId\", caller=\"identity.arn\", q=\"input.inputBodyJson.messages[0].content[0].text\", itok=\"input.inputTokenCount\", otok=\"output.outputTokenCount\" | caller=~\"${gateway_caller_re}\" | label_format pid=`{{ regexReplaceAll \".*/\" .pid \"\" }}` | label_format model=`${model_chain}` | line_format `[{{.model}} | {{.itok}} in / {{.otok}} out] {{ trunc 400 .q }}`",
                        "queryType": "range",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "showTime": true,
                "wrapLogMessage": true,
                "sortOrder": "Descending",
                "enableLogDetails": true,
                "dedupStrategy": "none"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
