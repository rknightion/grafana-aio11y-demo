      "mt-recent": {
        "kind": "Panel",
        "spec": {
          "id": 39,
          "title": "Recent tool calls with their inputs",
          "description": "Tool arguments are captured because the gateway pushes OTEL_LOG_TOOL_DETAILS=1.",
          "links": [],
