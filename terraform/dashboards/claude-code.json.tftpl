      "ov-spend-dev": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Spend by developer",
          "description": "Spend per developer (user.email), highest first.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sort_desc(sum by (user_email)(max_over_time(claude_code_cost_usage_USD_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\"}[$__range])))",
                        "legendFormat": "{{user_email}}",
                        "range": false,
                        "instant": true,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "orientation": "horizontal",
                "displayMode": "gradient",
                "valueMode": "color",
                "namePlacement": "top",
                "showUnfilled": true,
                "sizing": "manual",
                "minVizHeight": 16,
                "maxVizHeight": 36,
                "legend": {
                  "showLegend": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "currencyUSD",
                  "color": {
                    "mode": "continuous-BlPu"
                  },
                  "min": 0,
                  "displayName": "$${__series.name}",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "blue",
                        "value": null
                      }
                    ]
                  },
                  "decimals": 2
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ov-attribution": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Attribution by team and developer",
          "description": "The team comes from the user.groups attribute the CLI stamps from the gateway session, the developer from Claude Code's user.email. This is the answer to 'who spent what', without a gateway in the path.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (user_groups, user_email)(max_over_time(claude_code_cost_usage_USD_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\"}[$__range]))",
                        "legendFormat": "",
                        "range": false,
                        "instant": true,
                        "format": "table",
                        "refId": "A"
                      }
                    }
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "B",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (user_groups, user_email)(max_over_time(claude_code_token_usage_tokens_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\"}[$__range]))",
                        "legendFormat": "",
                        "range": false,
                        "instant": true,
                        "format": "table",
                        "refId": "B"
                      }
                    }
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "C",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "count by (user_groups, user_email)(count by (user_groups, user_email, session_id)(max_over_time(claude_code_session_count_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\"}[$__range])))",
                        "legendFormat": "",
                        "range": false,
                        "instant": true,
                        "format": "table",
                        "refId": "C"
                      }
                    }
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "merge",
                  "spec": {
                    "options": {}
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "enablePagination": false,
                "sortBy": [
                  {
                    "displayName": "Spend",
                    "desc": true
                  }
                ],
                "footer": {
                  "show": true,
                  "reducer": [
                    "sum"
                  ],
                  "fields": "",
                  "countRows": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": false,
                    "inspect": true
                  },
                  "color": {
                    "mode": "continuous-BlPu"
                  }
