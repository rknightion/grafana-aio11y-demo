                      "spec": {
                        "editorMode": "code",
                        "expr": "0.1 * sum(max_over_time(claude_code_token_usage_tokens_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\", type=\"cacheRead\"}[$__range]))",
