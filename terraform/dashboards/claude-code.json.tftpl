                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (rule_id, outcome) (increase(agento11y_hook_rule_outcomes_total{rule_id=~\"${cc_guard_re}\"}[$__interval]))",
                        "range": true,
                        "instant": false,
                        "refId": "A",
                        "legendFormat": "{{rule_id}} {{outcome}}"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "sum"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "pl-denies": {
        "kind": "Panel",
        "spec": {
          "id": 228,
          "title": "Guard denies and warns",
          "description": "Blocked or flagged by a Cloud guard over the range.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (rule_id, outcome) (increase(agento11y_hook_rule_outcomes_total{rule_id=~\"${cc_guard_re}\", outcome=~\"deny|warn\"}[$__range]))",
                        "range": false,
                        "instant": true,
                        "refId": "A",
                        "legendFormat": "{{rule_id}} {{outcome}}"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "",
            "spec": {
              "options": {
                "orientation": "horizontal",
                "displayMode": "basic",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "noValue": "0"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "pl-evals": {
        "kind": "Panel",
        "spec": {
          "id": 229,
          "title": "Online evaluation scores on Claude Code",
          "description": "agento11y_eval_scores_total for Claude Code agents, by evaluator and pass/fail.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (evaluator, passed) (increase(agento11y_eval_scores_total{gen_ai_agent_name=~\"claude-code.*\", rule=~\"${eval_rule_re}\"}[$__range]))",
                        "range": false,
                        "instant": true,
                        "refId": "A",
                        "legendFormat": "{{evaluator}} passed={{passed}}"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "",
            "spec": {
              "options": {
                "orientation": "horizontal",
                "displayMode": "basic",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "noValue": "no scores in range"
                },
                "overrides": []
              }
            }
          }
        }
      }
