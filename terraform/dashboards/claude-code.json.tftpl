      "ga-lat": {
        "kind": "Panel",
        "spec": {
          "id": 188,
          "title": "Latency p95 by model",
          "description": "Gateway-measured request duration for /v1/messages (includes model time; streams are timed to completion).",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "quantile_over_time(0.95, {service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=\"inference\" | path=\"/v1/messages\" | unwrap ms [$__auto]) by (model)",
                        "queryType": "range",
                        "refId": "A",
                        "legendFormat": "{{model}}"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "mean",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-dev-model": {
        "kind": "Panel",
        "spec": {
          "id": 189,
          "title": "Inference by developer, model and status",
          "description": "Who called which model, and how it went. Identity is the IdP email on the gateway session.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (email, model, path, status) (count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=\"inference\" [$__range]))",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [
                {
                  "id": "reduce",
                  "options": {
                    "reducers": [
                      "lastNotNull"
                    ],
                    "labelsToFields": true
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true,
                "sortBy": [
                  {
                    "displayName": "Value #A",
                    "desc": true
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-signins": {
        "kind": "Panel",
        "spec": {
          "id": 190,
          "title": "Sign-ins by developer",
          "description": "session.mint / session.refresh and the device flow, by email and result.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (evt, email, result) (count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=~\"device.authorize|device.verify|session.mint|session.refresh\" [$__range]))",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [
                {
                  "id": "reduce",
