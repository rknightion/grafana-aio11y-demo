                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": false,
                    "inspect": true
                  },
                  "color": {
                    "mode": "continuous-BlPu"
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Time"
                    },
                    "properties": [
                      {
                        "id": "custom.hidden",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "model"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Model"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "effort"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Effort"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "^Value.*"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Spend"
                      },
                      {
                        "id": "unit",
                        "value": "currencyUSD"
                      },
                      {
                        "id": "decimals",
                        "value": 3
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "gauge",
                          "mode": "gradient",
                          "valueDisplayMode": "text"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "ct-out-source": {
        "kind": "Panel",
        "spec": {
          "id": 24,
          "title": "Output tokens by query source",
          "description": "main = the interactive agent loop; other sources are sub-agents and background calls.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sort_desc(sum by (query_source)(max_over_time(claude_code_token_usage_tokens_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\", type=\"output\"}[$__range])))",
                        "legendFormat": "{{query_source}}",
                        "range": false,
                        "instant": true,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "orientation": "horizontal",
                "displayMode": "gradient",
                "valueMode": "color",
                "namePlacement": "top",
                "showUnfilled": true,
                "sizing": "manual",
                "minVizHeight": 16,
                "maxVizHeight": 36,
                "legend": {
                  "showLegend": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "continuous-BlPu"
                  },
                  "min": 0,
                  "displayName": "$${__series.name}",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "blue",
                        "value": null
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
