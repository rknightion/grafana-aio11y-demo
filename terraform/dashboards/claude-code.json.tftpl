      "gb-lat": {
        "kind": "Panel",
        "spec": {
          "id": 215,
          "title": "Calls and tokens by model and API operation",
          "description": "Streaming calls log no latencyMs in the invocation log; gateway-measured latency is on the gateway audit log tab.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (model, operation, region) (count_over_time(${bedrock_log_selector} | json pid=\"modelId\", caller=\"identity.arn\", itok=\"input.inputTokenCount\", otok=\"output.outputTokenCount\", lat=\"output.outputBodyJson.metrics.latencyMs\", stop=\"output.outputBodyJson.stopReason\", region=\"inferenceRegion\", operation=\"operation\" | caller=~\"${gateway_caller_re}\" | label_format pid=`{{ regexReplaceAll \".*/\" .pid \"\" }}` | label_format model=`${model_chain}` [$__range]))",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "B",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (model, operation, region) (sum_over_time(${bedrock_log_selector} | json pid=\"modelId\", caller=\"identity.arn\", itok=\"input.inputTokenCount\", otok=\"output.outputTokenCount\", lat=\"output.outputBodyJson.metrics.latencyMs\", stop=\"output.outputBodyJson.stopReason\", region=\"inferenceRegion\", operation=\"operation\" | caller=~\"${gateway_caller_re}\" | label_format pid=`{{ regexReplaceAll \".*/\" .pid \"\" }}` | label_format model=`${model_chain}` | unwrap otok [$__range]))",
                        "queryType": "instant",
                        "refId": "B"
                      }
                    }
                  }
                }
              ],
              "transformations": [
                {
                  "id": "merge",
                  "options": {}
                },
                {
                  "id": "organize",
                  "options": {
                    "excludeByName": {
                      "Time": true
                    },
                    "renameByName": {
                      "Value #A": "calls",
                      "Value #B": "output tokens"
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
