              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "drawStyle": "bars",
                    "lineWidth": 1,
                    "fillOpacity": 80,
                    "gradientMode": "none",
                    "showPoints": "never",
                    "pointSize": 5,
                    "barAlignment": 0,
                    "spanNulls": false,
                    "axisSoftMin": 0,
                    "stacking": {
                      "mode": "normal",
                      "group": "A"
