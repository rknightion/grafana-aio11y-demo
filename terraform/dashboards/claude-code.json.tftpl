      "ga-p95": {
        "kind": "Panel",
        "spec": {
          "id": 184,
          "title": "Inference latency p95",
          "description": "p95 of the gateway-measured ms for /v1/messages.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
