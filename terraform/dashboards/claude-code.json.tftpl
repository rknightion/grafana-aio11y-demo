                    "gradientMode": "none",
                    "showPoints": "never",
                    "pointSize": 5,
                    "barAlignment": 0,
                    "spanNulls": false,
                    "axisSoftMin": 0,
                    "stacking": {
                      "mode": "normal",
                      "group": "A"
                    }
                  },
                  "color": {
                    "mode": "palette-classic"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ct-weighted": {
        "kind": "Panel",
        "spec": {
          "id": 22,
          "title": "Weighted spend by token class",
          "description": "Tokens multiplied by their price weight relative to input tokens. Shows where the bill actually goes.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
