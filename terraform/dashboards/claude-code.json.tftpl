      "ov-sessions-table": {
        "kind": "Panel",
        "spec": {
          "id": 12,
          "title": "Sessions",
          "description": "One row per Claude Code session. Click a session id to open its prompts, responses and tool calls on the Sessions & content tab.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "min by (session_id, user_email, user_groups)(min_over_time(timestamp(claude_code_session_count_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\"})[$__range:30s])) * 1000",
                        "legendFormat": "",
                        "range": false,
                        "instant": true,
                        "format": "table",
                        "refId": "A"
                      }
                    }
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "B",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (session_id, user_email, user_groups)(max_over_time(claude_code_cost_usage_USD_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\"}[$__range]))",
                        "legendFormat": "",
                        "range": false,
                        "instant": true,
                        "format": "table",
                        "refId": "B"
                      }
                    }
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "C",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (session_id, user_email, user_groups)(max_over_time(claude_code_token_usage_tokens_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\"}[$__range]))",
                        "legendFormat": "",
                        "range": false,
                        "instant": true,
                        "format": "table",
                        "refId": "C"
                      }
                    }
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "D",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (session_id, user_email, user_groups)(max_over_time(claude_code_active_time_seconds_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\"}[$__range]))",
                        "legendFormat": "",
                        "range": false,
                        "instant": true,
                        "format": "table",
                        "refId": "D"
                      }
                    }
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "merge",
                  "spec": {
                    "options": {}
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "enablePagination": false,
                "sortBy": [
                  {
                    "displayName": "Started",
                    "desc": true
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
