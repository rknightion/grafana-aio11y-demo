      "mt-success": {
        "kind": "Panel",
        "spec": {
          "id": 28,
          "title": "Tool success rate",
          "description": "",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
