      "mc-by-server": {
        "kind": "Panel",
        "spec": {
          "id": 219,
          "title": "MCP tool calls by server",
          "description": "tool_result events for MCP tools, by MCP server.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (mcp_server_name) (count_over_time({service_name=\"claude-code\", service_namespace=\"${prefix}\"} | user_groups=~\"$team\" | user_email=~\"$user\" | session_id=~\"$session\" | event_name=\"tool_result\" | tool_name=\"mcp_tool\" | line_format \"{{.tool_parameters}}\" | json mcp_server_name, mcp_tool_name | drop __error__, __error_details__ [$__auto]))",
                        "queryType": "range",
                        "refId": "A",
                        "legendFormat": "{{mcp_server_name}}"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "sum"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "drawStyle": "bars",
                    "stacking": {
                      "mode": "normal"
                    },
                    "fillOpacity": 80
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "mc-scope": {
        "kind": "Panel",
        "spec": {
          "id": 221,
          "title": "MCP servers connected, by scope",
          "description": "mcp_server_connection events with status=connected. scope=managed means the server was pushed by the gateway's managedMcpServers, not configured by the developer.",
          "links": [],
          "transparent": false,
          "data": {
