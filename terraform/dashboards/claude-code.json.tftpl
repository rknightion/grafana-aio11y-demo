      "ga-model-rate": {
        "kind": "Panel",
        "spec": {
          "id": 187,
          "title": "Inference rate by model",
          "description": "Requests per interval by model name the client asked for.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
