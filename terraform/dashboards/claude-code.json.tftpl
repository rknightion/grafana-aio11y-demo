                      "spec": {
                        "expr": "sum by (sha256, path) (count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=\"config.load\" [$__range]))",
