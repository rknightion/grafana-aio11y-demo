      "ga-ips": {
        "kind": "Panel",
        "spec": {
          "id": 192,
          "title": "Client IPs",
          "description": "Where sign-ins and device flows came from (client_ip on auth events). The developer containers share the agent host's address.",
          "links": [],
          "transparent": false,
          "data": {
