                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (server_name, server_scope, transport_type) (count_over_time({service_name=\"claude-code\", service_namespace=\"${prefix}\"} | user_groups=~\"$team\" | user_email=~\"$user\" | session_id=~\"$session\" | event_name=\"mcp_server_connection\" | status=\"connected\" | server_name!=\"\" [$__range]))",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [
                {
                  "id": "reduce",
                  "options": {
                    "reducers": [
                      "lastNotNull"
                    ],
                    "labelsToFields": true
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ov-gw-cost": {
        "kind": "Panel",
        "spec": {
          "id": 223,
          "title": "Cost by developer and model",
          "description": "claude_code_cost_usage_USD_total per hour. user.email comes from the IdP via the gateway.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
