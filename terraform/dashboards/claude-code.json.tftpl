                      },
                      {
                        "id": "unit",
                        "value": "currencyUSD"
                      },
                      {
                        "id": "decimals",
                        "value": 3
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "gauge",
