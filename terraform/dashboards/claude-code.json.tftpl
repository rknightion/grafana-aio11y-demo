          "id": 60,
          "title": "Avg turn latency",
          "description": "Mean claude_code.interaction duration: prompt submitted to final answer, tools included. Averages rather than percentiles because TraceQL metrics quantiles snap to power-of-two buckets, which is misleading on a handful of turns.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
