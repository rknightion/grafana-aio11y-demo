      "gb-p95": {
        "kind": "Panel",
        "spec": {
          "id": 212,
          "title": "Streaming calls",
          "description": "InvokeModelWithResponseStream share: Claude Code streams every turn through the gateway.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "100 * sum(count_over_time(${bedrock_log_selector} | json pid=\"modelId\", caller=\"identity.arn\", itok=\"input.inputTokenCount\", otok=\"output.outputTokenCount\", lat=\"output.outputBodyJson.metrics.latencyMs\", stop=\"output.outputBodyJson.stopReason\", region=\"inferenceRegion\", operation=\"operation\" | caller=~\"${gateway_caller_re}\" | label_format pid=`{{ regexReplaceAll \".*/\" .pid \"\" }}` | label_format model=`${model_chain}` | operation=\"InvokeModelWithResponseStream\" [$__range])) / sum(count_over_time(${bedrock_log_selector} | json pid=\"modelId\", caller=\"identity.arn\", itok=\"input.inputTokenCount\", otok=\"output.outputTokenCount\", lat=\"output.outputBodyJson.metrics.latencyMs\", stop=\"output.outputBodyJson.stopReason\", region=\"inferenceRegion\", operation=\"operation\" | caller=~\"${gateway_caller_re}\" | label_format pid=`{{ regexReplaceAll \".*/\" .pid \"\" }}` | label_format model=`${model_chain}` [$__range]))",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "decimals": 0,
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "text"
                  },
                  "noValue": "-"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "gb-model": {
        "kind": "Panel",
        "spec": {
          "id": 213,
          "title": "Gateway traffic on Bedrock, by model",
          "description": "Calls per model, from the application inference profile the gateway maps each model to.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (model) (count_over_time(${bedrock_log_selector} | json pid=\"modelId\", caller=\"identity.arn\", itok=\"input.inputTokenCount\", otok=\"output.outputTokenCount\", lat=\"output.outputBodyJson.metrics.latencyMs\", stop=\"output.outputBodyJson.stopReason\", region=\"inferenceRegion\", operation=\"operation\" | caller=~\"${gateway_caller_re}\" | label_format pid=`{{ regexReplaceAll \".*/\" .pid \"\" }}` | label_format model=`${model_chain}` [$__auto]))",
                        "queryType": "range",
                        "refId": "A",
                        "legendFormat": "{{model}}"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "sum"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "drawStyle": "bars",
                    "stacking": {
