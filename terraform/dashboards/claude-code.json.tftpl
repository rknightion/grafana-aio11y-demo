                  "color": {
                    "mode": "palette-classic"
                  },
                  "decimals": 0
                },
                "overrides": []
              }
            }
          }
        }
      },
      "tr-a11y-gens": {
        "kind": "Panel",
        "spec": {
          "id": 68,
          "title": "agento11y generations",
          "description": "GenAI semantic-convention spans. gen_ai.conversation.id is the Claude Code session id.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_traces}"
                      },
                      "spec": {
                        "queryType": "traceql",
                        "query": "{resource.service.name=\"agento11y\" && span.agento11y.tag.service.namespace=\"${prefix}\" && span.gen_ai.agent.name=\"claude-code\" && span.gen_ai.conversation.id=~\"$${session:pipe}\" && span.gen_ai.operation.name=\"generateText\"} | select(span.gen_ai.conversation.id, span.gen_ai.response.finish_reasons, span.gen_ai.usage.input_tokens, span.gen_ai.usage.output_tokens, span.gen_ai.usage.cache_read_input_tokens)",
                        "limit": 50,
                        "tableType": "spans",
                        "spss": 3,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "enablePagination": false,
                "sortBy": [
                  {
                    "displayName": "time",
                    "desc": true
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": false,
                    "inspect": true
                  },
                  "color": {
                    "mode": "continuous-BlPu"
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Time"
                    },
                    "properties": [
                      {
                        "id": "custom.hidden",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "gen_ai.conversation.id"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Session"
                      },
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Open this session's conversation",
                            "url": "/d/${dash_claude_code}/?$${__url_time_range}&var-team=$${team}&var-user=$${user}&var-model=$${model}&var-session=$${__value.raw}&dtab=sessions-content"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "gen_ai.response.finish_reasons"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Finish"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "gen_ai.usage.input_tokens"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Input tokens"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "gen_ai.usage.output_tokens"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Output tokens"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "gen_ai.usage.cache_read_input_tokens"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Cache read"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "duration"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Duration"
                      },
                      {
                        "id": "unit",
                        "value": "ns"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "time"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Start"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Span ID"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Trace"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "^(Spans traceIdHidden|traceIdHidden|Trace Service|traceService|Trace Name|traceName|Name|name|service\\.name|team\\.name|gen_ai\\.agent\\.name|gen_ai\\.operation\\.name)$"
                    },
                    "properties": [
                      {
                        "id": "custom.hidden",
                        "value": true
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "ga-intro": {
        "kind": "Panel",
        "spec": {
          "id": 178,
          "title": "",
          "description": "",
          "links": [],
          "transparent": true,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "**Source: the Claude apps gateway's own audit log only** (one JSON line per event, with an `evt` field, on the gateway container's output on the agent host, shipped to Loki by the host Alloy as `service_name=${svc_gateway}`). Nothing here needs telemetry on the developer containers: every developer signs in through the gateway, and every model call passes through it. Events: `device.authorize` / `device.verify` / `session.mint` (sign-in with the IdP), `managed.serve` (the gateway pushing managed settings, including telemetry env and `managedMcpServers`), `inference` (every `/v1/messages` call with email, model, upstream, status and latency) and `config.load`. The gateway exposes no Prometheus metrics, so this tab is logs only. It never logs prompt content."
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "ga-devs": {
        "kind": "Panel",
        "spec": {
          "id": 179,
          "title": "Developers with a session",
          "description": "Distinct emails with a session.mint or inference event.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "count(sum by (email) (count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=~\"session.mint|session.refresh|inference\" [$__range])))",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "blue"
                  },
                  "noValue": "0"
                },
                "overrides": []
              }
            }
          }
        }
      },
