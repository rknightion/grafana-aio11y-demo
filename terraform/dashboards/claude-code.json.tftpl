{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "${dash_claude_code}"
  },
  "spec": {
    "title": "Observing Claude Code (${prefix})",
    "description": "One tab per data source for the demo developers: the Claude apps gateway audit log, the gateway's spend store, Bedrock's view of gateway traffic, Claude Code native OpenTelemetry pushed by the gateway, and the Agent Observability plugin.",
    "tags": [
      "${prefix}",
      "claude-code",
      "gateway",
      "otel",
      "agento11y"
    ],
    "editable": true,
    "liveNow": false,
    "preload": false,
    "cursorSync": "Crosshair",
    "timeSettings": {
      "from": "now-3h",
      "to": "now",
      "autoRefresh": "1m",
      "timezone": "browser",
      "autoRefreshIntervals": [
        "30s",
        "1m",
        "5m",
        "15m",
        "1h"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "links": [],
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "team",
          "label": "Team",
          "description": "user.groups, the IdP (Cognito) groups the gateway stamps on every export. One team per developer in this demo.",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${ds_prom}"
            },
            "spec": {
              "qryType": 1,
              "query": "label_values(claude_code_session_count_total{service_name=\"claude-code\", service_namespace=\"${prefix}\"}, user_groups)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          },
          "regex": "",
          "sort": "alphabeticalAsc",
          "definition": "label_values(claude_code_session_count_total{service_name=\"claude-code\", service_namespace=\"${prefix}\"}, user_groups)",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allowCustomValue": false,
          "allValue": ".*"
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "user",
          "label": "Developer",
          "description": "",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${ds_prom}"
            },
            "spec": {
              "qryType": 1,
              "query": "label_values(claude_code_session_count_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\"}, user_email)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          },
          "regex": "",
          "sort": "alphabeticalAsc",
          "definition": "label_values(claude_code_session_count_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\"}, user_email)",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allowCustomValue": false,
          "allValue": ".*"
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "model",
          "label": "Model",
          "description": "",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${ds_prom}"
            },
            "spec": {
              "qryType": 1,
              "query": "label_values(claude_code_cost_usage_USD_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\"}, model)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          },
          "regex": "",
          "sort": "alphabeticalAsc",
          "definition": "label_values(claude_code_cost_usage_USD_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\"}, model)",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allowCustomValue": false,
          "allValue": ".*"
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "session",
          "label": "Session",
          "description": "Claude Code session.id. Also the agento11y conversation id.",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${ds_prom}"
            },
            "spec": {
              "qryType": 1,
              "query": "label_values(claude_code_session_count_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\"}, session_id)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          },
          "regex": "",
          "sort": "alphabeticalAsc",
          "definition": "label_values(claude_code_session_count_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\"}, session_id)",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allowCustomValue": false,
          "allValue": ".*"
        }
      },
      {
        "kind": "CustomVariable",
        "spec": {
          "name": "mcp_scope",
          "label": "MCP server scope",
          "query": "user,managed,dynamic,claudeai,project,local",
          "description": "MCP server scope. managed = pushed by the gateway's managedMcpServers.",
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "options": [
            {
              "text": "user",
              "value": "user",
              "selected": false
            },
            {
              "text": "managed",
              "value": "managed",
              "selected": false
            },
            {
              "text": "dynamic",
              "value": "dynamic",
              "selected": false
            },
            {
              "text": "claudeai",
              "value": "claudeai",
              "selected": false
            },
            {
              "text": "project",
              "value": "project",
              "selected": false
            },
            {
              "text": "local",
              "value": "local",
              "selected": false
            }
          ],
          "multi": true,
          "includeAll": true,
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false,
          "allValue": ".*"
        }
      }
    ],
    "elements": {
      "ov-spend": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Spend",
          "description": "Claude Code's own cost estimate in USD for the selected team, developers, models and sessions. Each session exports its own cumulative counter, so the total is the sum of every session's peak value.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(max_over_time(claude_code_cost_usage_USD_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\"}[$__range]))",
                        "legendFormat": "",
                        "range": false,
                        "instant": true,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "wideLayout": true,
                "showPercentChange": false,
                "orientation": "auto",
                "text": {
                  "valueSize": 34
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "currencyUSD",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  },
                  "noValue": "0",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      }
                    ]
                  },
                  "decimals": 2
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ov-sessions": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Sessions",
          "description": "Distinct Claude Code sessions (session.id) that exported telemetry in the range.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "count(count by (session_id)(max_over_time(claude_code_session_count_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\"}[$__range])))",
                        "legendFormat": "",
                        "range": false,
                        "instant": true,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "wideLayout": true,
                "showPercentChange": false,
                "orientation": "auto",
                "text": {
                  "valueSize": 34
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "blue"
                  },
                  "noValue": "0",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "blue",
                        "value": null
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ov-devs": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Developers",
          "description": "Distinct developers (user.email) with at least one session in the range.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "count(count by (user_email)(max_over_time(claude_code_session_count_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\"}[$__range])))",
                        "legendFormat": "",
                        "range": false,
                        "instant": true,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "wideLayout": true,
                "showPercentChange": false,
                "orientation": "auto",
                "text": {
                  "valueSize": 34
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "purple"
                  },
                  "noValue": "0",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "purple",
                        "value": null
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ov-tokens": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Tokens",
          "description": "All tokens processed: input, output, cache read and cache write.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(max_over_time(claude_code_token_usage_tokens_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\"}[$__range]))",
                        "legendFormat": "",
                        "range": false,
                        "instant": true,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "wideLayout": true,
                "showPercentChange": false,
                "orientation": "auto",
                "text": {
                  "valueSize": 34
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "orange"
                  },
                  "noValue": "0",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "orange",
                        "value": null
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ov-per-session": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Avg spend per session",
          "description": "Spend divided by the number of sessions that recorded spend.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(max_over_time(claude_code_cost_usage_USD_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\"}[$__range])) / count(count by (session_id)(max_over_time(claude_code_cost_usage_USD_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\"}[$__range])))",
                        "legendFormat": "",
                        "range": false,
                        "instant": true,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "wideLayout": true,
                "showPercentChange": false,
                "orientation": "auto",
                "text": {
                  "valueSize": 34
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "currencyUSD",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "yellow"
                  },
                  "noValue": "0",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "yellow",
                        "value": null
                      }
                    ]
                  },
                  "decimals": 3
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ov-active": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Active time",
          "description": "Time Claude Code was actively working (claude_code.active_time), summed across sessions.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(max_over_time(claude_code_active_time_seconds_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\"}[$__range]))",
                        "legendFormat": "",
                        "range": false,
                        "instant": true,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "wideLayout": true,
                "showPercentChange": false,
                "orientation": "auto",
                "text": {
                  "valueSize": 34
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "red"
                  },
                  "noValue": "0",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "red",
                        "value": null
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ov-spend-time": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Spend over time by model",
          "description": "New spend per interval. Each point is the growth of every session's cumulative cost counter, with a session's first sample counted in full, so short sessions are not lost the way increase() loses them.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (model)((max_over_time(claude_code_cost_usage_USD_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\"}[$__interval]) - max_over_time(claude_code_cost_usage_USD_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\"}[$__interval] offset $__interval)) or max_over_time(claude_code_cost_usage_USD_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\"}[$__interval]))",
                        "legendFormat": "{{model}}",
                        "range": true,
                        "instant": false,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "5m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "sum"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "currencyUSD",
                  "custom": {
                    "drawStyle": "bars",
                    "lineWidth": 1,
                    "fillOpacity": 80,
                    "gradientMode": "none",
                    "showPoints": "never",
                    "pointSize": 5,
                    "barAlignment": 0,
                    "spanNulls": false,
                    "axisSoftMin": 0,
                    "stacking": {
                      "mode": "normal",
                      "group": "A"
                    }
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "decimals": 3
                },
                "overrides": []
              }
            }
