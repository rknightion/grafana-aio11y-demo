      "mt-calls-tool": {
        "kind": "Panel",
        "spec": {
          "id": 34,
          "title": "Calls by tool",
          "description": "MCP tools show as server / tool, parsed from the tool_parameters attribute on each tool_result event.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (tool) (count_over_time({service_name=\"claude-code\", service_namespace=\"${prefix}\"} | user_groups=~\"$team\" | user_email=~\"$user\" | session_id=~\"$session\" | event_name=\"tool_result\" | line_format \"{{.tool_parameters}}\" | json mcp_server_name, mcp_tool_name | drop __error__, __error_details__ | label_format tool=`{{ if .mcp_tool_name }}{{ .mcp_server_name }} / {{ .mcp_tool_name }}{{ else if eq .tool_name \"mcp_tool\" }}MCP (name not exported){{ else }}{{ .tool_name }}{{ end }}` [$__range]))",
                        "legendFormat": "",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "enablePagination": false,
                "sortBy": [
                  {
                    "displayName": "Calls",
                    "desc": true
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": false,
                    "inspect": true
                  },
                  "color": {
                    "mode": "continuous-BlPu"
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Time"
                    },
                    "properties": [
                      {
                        "id": "custom.hidden",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "tool"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Tool"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "^Value.*"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Calls"
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "gauge",
                          "mode": "gradient",
                          "valueDisplayMode": "text"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "mt-attr": {
        "kind": "Panel",
        "spec": {
          "id": 35,
          "title": "MCP attribution: spend and tokens by server and tool",
          "description": "Native Claude Code cost and token metrics grouped by mcp_server.name and mcp_tool.name. An AI gateway cannot see this: MCP calls never cross it.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (mcp_server_name, mcp_tool_name)(max_over_time(claude_code_cost_usage_USD_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\", mcp_server_name!=\"\"}[$__range]))",
                        "legendFormat": "",
                        "range": false,
                        "instant": true,
                        "format": "table",
                        "refId": "A"
                      }
                    }
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "B",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (mcp_server_name, mcp_tool_name)(max_over_time(claude_code_token_usage_tokens_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\", mcp_server_name!=\"\"}[$__range]))",
                        "legendFormat": "",
                        "range": false,
                        "instant": true,
                        "format": "table",
                        "refId": "B"
                      }
                    }
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "C",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "count by (mcp_server_name, mcp_tool_name)(count by (mcp_server_name, mcp_tool_name, session_id)(max_over_time(claude_code_cost_usage_USD_total{service_name=\"claude-code\", service_namespace=\"${prefix}\", user_groups=~\"$team\", user_email=~\"$user\", session_id=~\"$session\", model=~\"$model\", mcp_server_name!=\"\"}[$__range])))",
                        "legendFormat": "",
                        "range": false,
                        "instant": true,
                        "format": "table",
                        "refId": "C"
                      }
                    }
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "merge",
                  "spec": {
                    "options": {}
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "enablePagination": false,
                "sortBy": [
                  {
                    "displayName": "Spend",
                    "desc": true
                  }
                ],
                "footer": {
                  "show": true,
                  "reducer": [
                    "sum"
                  ],
                  "fields": "",
                  "countRows": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": false,
                    "inspect": true
                  },
                  "color": {
                    "mode": "continuous-BlPu"
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Time"
                    },
                    "properties": [
                      {
                        "id": "custom.hidden",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "mcp_server_name"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "MCP server"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "mcp_tool_name"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "MCP tool"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Value #A"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Spend"
                      },
                      {
                        "id": "unit",
                        "value": "currencyUSD"
                      },
                      {
                        "id": "decimals",
                        "value": 3
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "gauge",
                          "mode": "gradient",
                          "valueDisplayMode": "text"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Value #B"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Tokens"
                      },
                      {
                        "id": "unit",
                        "value": "short"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Value #C"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Sessions"
                      },
                      {
                        "id": "unit",
                        "value": "short"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "mt-latency-tool": {
        "kind": "Panel",
        "spec": {
          "id": 36,
          "title": "Tool latency by tool (p95)",
          "description": "",
