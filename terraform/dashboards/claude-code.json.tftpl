            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "**What a gateway can and cannot see.** An AI gateway in front of the model API can allow-list which MCP servers a client may load, but MCP tool calls never pass through it. The `mcp_server_name` and `mcp_tool_name` breakdowns on this dashboard come from Claude Code itself.\n\n**How totals are counted.** Claude Code exports one cumulative counter per session, and a short session may leave a single sample. Rate-style functions need two samples and would read zero, so totals here sum each series' peak over the time range, and charts over time count a session's first sample in full.\n\n**Scope.** Every Claude Code query is filtered to `service_name=claude-code`, `service_namespace=${prefix}` and the selected team, so other Claude Code users of the same stack never appear.\n",
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false,
                  "showMiniMap": false
                }
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "tr-gens": {
        "kind": "Panel",
        "spec": {
          "id": 62,
          "title": "agento11y generations",
          "description": "generateText spans from the agento11y Claude Code plugin (service.name=agento11y by design). The same turns appear as conversations in Agent Observability.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_traces}"
                      },
                      "spec": {
                        "queryType": "traceql",
                        "query": "{resource.service.name=\"agento11y\" && span.agento11y.tag.service.namespace=\"${prefix}\" && span.gen_ai.agent.name=\"claude-code\" && span.gen_ai.conversation.id=~\"$${session:pipe}\" && span.gen_ai.operation.name=\"generateText\"} | count_over_time()",
                        "limit": 20,
                        "metricsQueryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "wideLayout": true,
                "showPercentChange": false,
                "orientation": "auto",
                "text": {
                  "valueSize": 34
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  },
                  "noValue": "0",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "tr-a11y-tools": {
        "kind": "Panel",
        "spec": {
          "id": 67,
          "title": "agento11y tool executions by tool",
          "description": "execute_tool spans from the agento11y plugin, named mcp__<server>__<tool> for MCP tools.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_traces}"
                      },
                      "spec": {
                        "queryType": "traceql",
                        "query": "{resource.service.name=\"agento11y\" && span.agento11y.tag.service.namespace=\"${prefix}\" && span.gen_ai.agent.name=\"claude-code\" && span.gen_ai.conversation.id=~\"$${session:pipe}\" && span.gen_ai.operation.name=\"execute_tool\"} | count_over_time() by (span.gen_ai.tool.name)",
                        "limit": 20,
                        "metricsQueryType": "range",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
