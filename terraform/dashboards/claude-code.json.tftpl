      "tr-recent": {
        "kind": "Panel",
        "spec": {
          "id": 63,
          "title": "Recent turns",
          "description": "Each row is a claude_code.interaction span. Click the trace to see the LLM requests, permission waits and tool executions inside the turn.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_traces}"
                      },
                      "spec": {
                        "queryType": "traceql",
                        "query": "{resource.service.name=\"claude-code\" && resource.service.namespace=\"${prefix}\" && span.user.email=~\"$${user:pipe}\" && span.session.id=~\"$${session:pipe}\" && name=\"claude_code.interaction\"} | select(span.user_prompt, span.session.id, span.user.email)",
                        "limit": 50,
                        "tableType": "spans",
                        "spss": 3,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "enablePagination": false,
                "sortBy": [
                  {
                    "displayName": "time",
                    "desc": true
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": false,
                    "inspect": true
                  },
                  "color": {
                    "mode": "continuous-BlPu"
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Time"
                    },
                    "properties": [
                      {
                        "id": "custom.hidden",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "user_prompt"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Prompt"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "session.id"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Session"
                      },
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Open this session's conversation",
                            "url": "/d/${dash_claude_code}/?$${__url_time_range}&var-team=$${team}&var-user=$${user}&var-model=$${model}&var-session=$${__value.raw}&dtab=sessions-content"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "user.email"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Developer"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "duration"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Duration"
                      },
                      {
                        "id": "unit",
                        "value": "ns"
                      },
                      {
                        "id": "custom.width",
                        "value": 110
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "time"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Start"
                      },
                      {
                        "id": "custom.width",
                        "value": 190
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Span ID"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Trace"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "^(Spans traceIdHidden|traceIdHidden|Trace Service|traceService|Trace Name|traceName|Name|name|service\\.name|team\\.name|gen_ai\\.agent\\.name|gen_ai\\.operation\\.name)$"
                    },
                    "properties": [
                      {
                        "id": "custom.hidden",
                        "value": true
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "tr-ttft-time": {
        "kind": "Panel",
        "spec": {
          "id": 64,
          "title": "Avg time to first token by model",
          "description": "Mean ttft_ms attribute on claude_code.llm_request spans, per model. TTFT is only on traces, not on metrics.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_traces}"
                      },
                      "spec": {
                        "queryType": "traceql",
                        "query": "{resource.service.name=\"claude-code\" && resource.service.namespace=\"${prefix}\" && span.user.email=~\"$${user:pipe}\" && span.session.id=~\"$${session:pipe}\" && name=\"claude_code.llm_request\"} | avg_over_time(span.ttft_ms) by (span.model)",
                        "limit": 20,
                        "metricsQueryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "renameByRegex",
                  "spec": {
                    "options": {
                      "regex": ".*span\\.model=\"([^\"]+)\".*",
                      "renamePattern": "$1"
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "orientation": "horizontal",
                "displayMode": "gradient",
                "valueMode": "color",
                "namePlacement": "top",
                "showUnfilled": true,
                "sizing": "manual",
                "minVizHeight": 16,
                "maxVizHeight": 36,
                "legend": {
                  "showLegend": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "color": {
                    "mode": "continuous-BlPu"
                  },
                  "min": 0,
                  "displayName": "$${__series.name}",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "blue",
                        "value": null
                      }
                    ]
                  },
                  "decimals": 0
                },
                "overrides": []
              }
            }
          }
        }
      },
