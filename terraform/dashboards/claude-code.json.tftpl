          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (event_timestamp, session_id, prompt) (count_over_time({service_name=\"claude-code\", service_namespace=\"${prefix}\"} | user_groups=~\"$team\" | user_email=~\"$user\" | session_id=~\"$session\" | event_name=\"user_prompt\" [$__range]))",
                        "legendFormat": "",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "enablePagination": false,
                "sortBy": [
                  {
                    "displayName": "Time (UTC)",
                    "desc": true
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": false,
                    "inspect": true
                  },
                  "color": {
                    "mode": "continuous-BlPu"
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Time"
                    },
                    "properties": [
                      {
                        "id": "custom.hidden",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "event_timestamp"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Time (UTC)"
                      },
                      {
                        "id": "custom.width",
                        "value": 210
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "session_id"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Session"
                      },
                      {
                        "id": "custom.width",
                        "value": 300
                      },
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Open this session's conversation",
                            "url": "/d/${dash_claude_code}/?$${__url_time_range}&var-team=$${team}&var-user=$${user}&var-model=$${model}&var-session=$${__value.raw}&dtab=sessions-content"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "prompt"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Prompt"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "^Value.*"
                    },
                    "properties": [
                      {
                        "id": "custom.hidden",
                        "value": true
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
