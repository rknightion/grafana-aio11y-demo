          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "{service_name=\"claude-code\", service_namespace=\"${prefix}\"} | user_groups=~\"$team\" | user_email=~\"$user\" | session_id=~\"$session\" | event_name=\"tool_result\" | line_format \"{{.tool_parameters}}\" | json mcp_server_name, mcp_tool_name | drop __error__, __error_details__ | label_format tool=`{{ if .mcp_tool_name }}{{ .mcp_server_name }} / {{ .mcp_tool_name }}{{ else if eq .tool_name \"mcp_tool\" }}MCP (name not exported){{ else }}{{ .tool_name }}{{ end }}` | line_format `{{ .tool }}  success={{ .success }}  {{ .duration_ms }}ms  session={{ .session_id }}  {{ trunc 300 .tool_input }}`",
