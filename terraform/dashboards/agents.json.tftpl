                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(sum by (service,span_name,status_code)(rate(traces_spanmetrics_calls_total{service_namespace=\"${prefix}\",span_kind=\"SPAN_KIND_SERVER\",span_name=\"POST\"}[$__rate_interval]))) * 3600",
                        "legendFormat": "{{service}} {{span_name}} {{status_code}}",
                        "range": true,
                        "instant": false,
                        "refId": "A"
                      }
