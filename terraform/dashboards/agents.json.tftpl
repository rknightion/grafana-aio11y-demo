            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "### Query scope\n\nHTTP panels use `service_namespace=\"${prefix}\",service_name=\"${svc_site_api}\"`; agent Mimir panels use `service_name=~\"${agents_re}\"`. Tempo panels use exact service names or `service.namespace=\"${prefix}\"` with the agent names. Eval counters use rule `${eval_quality_rule}`; guard counters use rule id `${guard_injection_rule}`.",
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false,
                  "showMiniMap": false
