      "cost-total": {
        "kind": "Panel",
        "spec": {
          "id": 14,
          "title": "Estimated model cost",
          "description": "Model cost estimate from generation logs. Deduplicates repeated log records by trace and span before pricing tokens; not Bedrock billing.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum (((sum by (model) (max by (trace_id,span_id,model) (max_over_time({service_name=~\"${agents_re}\",service_namespace=\"${prefix}\"} | json | event=\"generation\" | model=~\".*haiku.*\" | unwrap inputTokens [$__range])))*1.1e-06) + (sum by (model) (max by (trace_id,span_id,model) (max_over_time({service_name=~\"${agents_re}\",service_namespace=\"${prefix}\"} | json | event=\"generation\" | model=~\".*haiku.*\" | unwrap outputTokens [$__range])))*5.5e-06)) or ((sum by (model) (max by (trace_id,span_id,model) (max_over_time({service_name=~\"${agents_re}\",service_namespace=\"${prefix}\"} | json | event=\"generation\" | model=~\".*sonnet.*\" | unwrap inputTokens [$__range])))*3.3e-06) + (sum by (model) (max by (trace_id,span_id,model) (max_over_time({service_name=~\"${agents_re}\",service_namespace=\"${prefix}\"} | json | event=\"generation\" | model=~\".*sonnet.*\" | unwrap outputTokens [$__range])))*1.65e-05)) or ((sum by (model) (max by (trace_id,span_id,model) (max_over_time({service_name=~\"${agents_re}\",service_namespace=\"${prefix}\"} | json | event=\"generation\" | model=\"sonnet-5\" | unwrap inputTokens [$__range])))*2.2e-06) + (sum by (model) (max by (trace_id,span_id,model) (max_over_time({service_name=~\"${agents_re}\",service_namespace=\"${prefix}\"} | json | event=\"generation\" | model=\"sonnet-5\" | unwrap outputTokens [$__range])))*1.1e-05)))",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "wideLayout": true,
                "showPercentChange": false,
                "orientation": "auto",
                "text": {
                  "valueSize": 34
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "currencyUSD",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  },
                  "noValue": "0",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      }
                    ]
                  },
                  "decimals": 4
                },
                "overrides": []
              }
            }
          }
        }
      },
      "cost-agent": {
        "kind": "Panel",
        "spec": {
          "id": 15,
          "title": "Estimated cost by agent and model / hour",
          "description": "Token-priced spend rate in USD per hour; not Bedrock billing. Team attribution is absent from these metrics.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "((sum by (service_name,gen_ai_request_model)(rate(gen_ai_client_token_usage_sum{service_namespace=\"${prefix}\",service_name=~\"${agents_re}\",gen_ai_request_model=~\".*haiku.*\",gen_ai_token_type=\"input\"}[$__rate_interval]))*1.1e-06 + sum by (service_name,gen_ai_request_model)(rate(gen_ai_client_token_usage_sum{service_namespace=\"${prefix}\",service_name=~\"${agents_re}\",gen_ai_request_model=~\".*haiku.*\",gen_ai_token_type=\"output\"}[$__rate_interval]))*5.5e-06) or (sum by (service_name,gen_ai_request_model)(rate(gen_ai_client_token_usage_sum{service_namespace=\"${prefix}\",service_name=~\"${agents_re}\",gen_ai_request_model=~\".*sonnet.*\",gen_ai_token_type=\"input\"}[$__rate_interval]))*3.3e-06 + sum by (service_name,gen_ai_request_model)(rate(gen_ai_client_token_usage_sum{service_namespace=\"${prefix}\",service_name=~\"${agents_re}\",gen_ai_request_model=~\".*sonnet.*\",gen_ai_token_type=\"output\"}[$__rate_interval]))*1.65e-05) or (sum by (service_name,gen_ai_request_model)(rate(gen_ai_client_token_usage_sum{service_namespace=\"${prefix}\",service_name=~\"${agents_re}\",gen_ai_request_model=~\".*sonnet-5.*\",gen_ai_token_type=\"input\"}[$__rate_interval]))*2.2e-06 + sum by (service_name,gen_ai_request_model)(rate(gen_ai_client_token_usage_sum{service_namespace=\"${prefix}\",service_name=~\"${agents_re}\",gen_ai_request_model=~\".*sonnet-5.*\",gen_ai_token_type=\"output\"}[$__rate_interval]))*1.1e-05)) * 3600",
                        "legendFormat": "{{service_name}} {{gen_ai_request_model}}",
                        "range": true,
                        "instant": false,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "5m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "lastNotNull"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "currencyUSD",
                  "custom": {
                    "drawStyle": "bars",
                    "lineWidth": 1,
                    "fillOpacity": 80,
                    "gradientMode": "none",
                    "showPoints": "never",
                    "pointSize": 5,
                    "barAlignment": 0,
                    "spanNulls": false,
                    "axisSoftMin": 0,
                    "stacking": {
                      "mode": "normal",
                      "group": "A"
                    }
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "decimals": 3
                },
                "overrides": []
              }
            }
          }
        }
      },
