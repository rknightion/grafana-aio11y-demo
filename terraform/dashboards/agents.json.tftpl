      "version-generations": {
        "kind": "Panel",
        "spec": {
          "id": 35,
          "title": "Orchestrator generations by version / hour",
          "description": "Generation throughput by gen_ai.agent.version, in operations per hour.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(sum by(gen_ai_agent_version)(rate(gen_ai_client_operation_duration_seconds_count{service_namespace=\"${prefix}\",service_name=\"${svc_orchestrator}\",gen_ai_operation_name=\"generateText\"}[$__rate_interval]))) * 3600",
                        "legendFormat": "{{gen_ai_agent_version}}",
                        "range": true,
                        "instant": false,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "5m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "lastNotNull"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "drawStyle": "bars",
                    "lineWidth": 1,
                    "fillOpacity": 80,
                    "gradientMode": "none",
                    "showPoints": "never",
                    "pointSize": 5,
                    "barAlignment": 0,
                    "spanNulls": false,
                    "axisSoftMin": 0,
                    "stacking": {
                      "mode": "normal",
                      "group": "A"
                    }
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "decimals": 3
                },
                "overrides": []
              }
            }
          }
        }
      },
      "version-p95": {
        "kind": "Panel",
        "spec": {
          "id": 36,
          "title": "Orchestrator p95 by version",
          "description": "Generation duration grouped by the emitted gen_ai.agent.version.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.95,sum by(le,gen_ai_agent_version)(rate(gen_ai_client_operation_duration_seconds_bucket{service_namespace=\"${prefix}\",service_name=\"${svc_orchestrator}\",gen_ai_operation_name=\"generateText\"}[5m])))",
                        "legendFormat": "{{gen_ai_agent_version}}",
                        "range": true,
                        "instant": false,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "5m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "lastNotNull"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "custom": {
                    "drawStyle": "line",
                    "lineWidth": 2,
                    "fillOpacity": 15,
                    "gradientMode": "none",
                    "showPoints": "never",
                    "pointSize": 5,
                    "barAlignment": 0,
                    "spanNulls": false,
                    "axisSoftMin": 0,
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    }
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "decimals": 3
                },
                "overrides": []
              }
            }
          }
        }
      },
      "version-cost": {
        "kind": "Panel",
        "spec": {
          "id": 37,
          "title": "Estimated orchestrator cost by version / hour",
          "description": "Token-priced spend rate in USD per hour by orchestrator version; not Bedrock billing.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(sum by(gen_ai_agent_version) ((sum by(gen_ai_agent_version,gen_ai_request_model)(rate(gen_ai_client_token_usage_sum{service_namespace=\"${prefix}\",service_name=\"${svc_orchestrator}\",gen_ai_request_model=~\".*haiku.*\",gen_ai_token_type=\"input\"}[$__rate_interval]))*1.1e-06 + sum by(gen_ai_agent_version,gen_ai_request_model)(rate(gen_ai_client_token_usage_sum{service_namespace=\"${prefix}\",service_name=\"${svc_orchestrator}\",gen_ai_request_model=~\".*haiku.*\",gen_ai_token_type=\"output\"}[$__rate_interval]))*5.5e-06) or (sum by(gen_ai_agent_version,gen_ai_request_model)(rate(gen_ai_client_token_usage_sum{service_namespace=\"${prefix}\",service_name=\"${svc_orchestrator}\",gen_ai_request_model=~\".*sonnet.*\",gen_ai_token_type=\"input\"}[$__rate_interval]))*3.3e-06 + sum by(gen_ai_agent_version,gen_ai_request_model)(rate(gen_ai_client_token_usage_sum{service_namespace=\"${prefix}\",service_name=\"${svc_orchestrator}\",gen_ai_request_model=~\".*sonnet.*\",gen_ai_token_type=\"output\"}[$__rate_interval]))*1.65e-05) or (sum by(gen_ai_agent_version,gen_ai_request_model)(rate(gen_ai_client_token_usage_sum{service_namespace=\"${prefix}\",service_name=\"${svc_orchestrator}\",gen_ai_request_model=~\".*sonnet-5.*\",gen_ai_token_type=\"input\"}[$__rate_interval]))*2.2e-06 + sum by(gen_ai_agent_version,gen_ai_request_model)(rate(gen_ai_client_token_usage_sum{service_namespace=\"${prefix}\",service_name=\"${svc_orchestrator}\",gen_ai_request_model=~\".*sonnet-5.*\",gen_ai_token_type=\"output\"}[$__rate_interval]))*1.1e-05))) * 3600",
                        "legendFormat": "{{gen_ai_agent_version}}",
                        "range": true,
                        "instant": false,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "5m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "lastNotNull"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "currencyUSD",
                  "custom": {
                    "drawStyle": "bars",
                    "lineWidth": 1,
                    "fillOpacity": 80,
                    "gradientMode": "none",
                    "showPoints": "never",
                    "pointSize": 5,
                    "barAlignment": 0,
                    "spanNulls": false,
                    "axisSoftMin": 0,
                    "stacking": {
                      "mode": "normal",
                      "group": "A"
                    }
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "decimals": 3
                },
                "overrides": []
              }
            }
          }
        }
      },
      "conv-links": {
        "kind": "Panel",
        "spec": {
          "id": 38,
          "title": "Agent conversations and trace links",
          "description": "Generation spans with conversation and trace IDs. Links open the Agent Observability conversation, Tempo trace, trace-filtered Loki logs, and the selected conversation cost panel.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_traces}"
                      },
                      "spec": {
                        "queryType": "traceql",
                        "query": "{ resource.service.namespace = \"${prefix}\" && span.gen_ai.agent.name =~ \"${agents_re}\" && span.gen_ai.operation.name = \"generateText\" } | select(span.gen_ai.conversation.id, span.gen_ai.agent.name, span.gen_ai.agent.version, span.gen_ai.request.model, span.gen_ai.usage.input_tokens, span.gen_ai.usage.output_tokens)",
                        "limit": 100,
                        "tableType": "spans",
                        "spss": 3,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "organize",
                  "spec": {
                    "id": "organize",
                    "options": {
                      "excludeByName": {},
                      "indexByName": {},
                      "renameByName": {
                        "traceIdHidden": "trace_id"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "enablePagination": false,
                "sortBy": [
                  {
                    "displayName": "time",
                    "desc": true
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": false,
                    "inspect": true
                  },
                  "color": {
                    "mode": "continuous-BlPu"
                  },
                  "unit": "short"
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Time"
                    },
                    "properties": [
                      {
                        "id": "custom.hidden",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "user_prompt"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Prompt"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "user.email"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Developer"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "duration"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Duration"
                      },
                      {
                        "id": "unit",
                        "value": "ns"
                      },
                      {
                        "id": "custom.width",
                        "value": 110
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "time"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Start"
                      },
                      {
                        "id": "custom.width",
                        "value": 190
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Span ID"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Trace"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "^(Spans traceIdHidden|trace_id|Trace Service|traceService|Trace Name|traceName|Name|name|service\\.name|team\\.name|gen_ai\\.agent\\.name|gen_ai\\.operation\\.name)$"
                    },
                    "properties": [
                      {
                        "id": "custom.hidden",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "gen_ai.conversation.id"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Conversation"
                      },
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Open agent conversation",
                            "url": "/a/grafana-agento11y-app/conversations/$${__value.raw}"
                          },
                          {
                            "title": "Open Tempo trace",
                            "url": "/explore?panes={\"gcx\":{\"compact\":false,\"datasource\":\"${ds_traces}\",\"queries\":[{\"datasource\":{\"type\":\"tempo\",\"uid\":\"${ds_traces}\"},\"query\":\"$${__data.fields.trace_id}\",\"queryType\":\"traceId\",\"refId\":\"A\",\"tableType\":\"traces\"}],\"range\":{\"from\":\"now-6h\",\"to\":\"now\"}}}&schemaVersion=1&traceId=$${__data.fields.trace_id}"
                          },
                          {
                            "title": "Open Loki logs for trace",
                            "url": "/explore?panes={\"gcx\":{\"compact\":false,\"datasource\":\"${ds_logs}\",\"queries\":[{\"datasource\":{\"type\":\"loki\",\"uid\":\"${ds_logs}\"},\"editorMode\":\"code\",\"expr\":\"{service_name=~\\\"${agents_re}|${svc_site_api}\\\", service_namespace=\\\"${prefix}\\\"} | trace_id=\\\"$${__data.fields.trace_id}\\\"\",\"queryType\":\"range\",\"refId\":\"A\"}],\"range\":{\"from\":\"now-6h\",\"to\":\"now\"}}}&schemaVersion=1"
                          },
                          {
                            "title": "Open conversation cost",
                            "url": "/d/${dash_agents}?viewPanel=39&var-trace_id=$${__data.fields.trace_id}"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "cost-conversation": {
        "kind": "Panel",
        "spec": {
          "id": 39,
          "title": "Estimated cost for selected conversation",
          "description": "Select a trace from a conversation row. The Loki calculation deduplicates each generation by trace and span, then applies the list model prices.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (trace_id) (((sum by (trace_id,model) (max by (trace_id,span_id,model) (max_over_time({service_name=~\"${agents_re}\",service_namespace=\"${prefix}\"} | json | event=\"generation\" | trace_id=\"$trace_id\" | model=~\".*haiku.*\" | unwrap inputTokens [$__range])))*1.1e-06) + (sum by (trace_id,model) (max by (trace_id,span_id,model) (max_over_time({service_name=~\"${agents_re}\",service_namespace=\"${prefix}\"} | json | event=\"generation\" | trace_id=\"$trace_id\" | model=~\".*haiku.*\" | unwrap outputTokens [$__range])))*5.5e-06)) or ((sum by (trace_id,model) (max by (trace_id,span_id,model) (max_over_time({service_name=~\"${agents_re}\",service_namespace=\"${prefix}\"} | json | event=\"generation\" | trace_id=\"$trace_id\" | model=~\".*sonnet.*\" | unwrap inputTokens [$__range])))*3.3e-06) + (sum by (trace_id,model) (max by (trace_id,span_id,model) (max_over_time({service_name=~\"${agents_re}\",service_namespace=\"${prefix}\"} | json | event=\"generation\" | trace_id=\"$trace_id\" | model=~\".*sonnet.*\" | unwrap outputTokens [$__range])))*1.65e-05)) or ((sum by (trace_id,model) (max by (trace_id,span_id,model) (max_over_time({service_name=~\"${agents_re}\",service_namespace=\"${prefix}\"} | json | event=\"generation\" | trace_id=\"$trace_id\" | model=\"sonnet-5\" | unwrap inputTokens [$__range])))*2.2e-06) + (sum by (trace_id,model) (max by (trace_id,span_id,model) (max_over_time({service_name=~\"${agents_re}\",service_namespace=\"${prefix}\"} | json | event=\"generation\" | trace_id=\"$trace_id\" | model=\"sonnet-5\" | unwrap outputTokens [$__range])))*1.1e-05)))",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "wideLayout": true,
                "showPercentChange": false,
                "orientation": "auto",
                "text": {
                  "valueSize": 34
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "currencyUSD",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  },
                  "noValue": "0",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      }
                    ]
                  },
                  "decimals": 5
                },
                "overrides": []
              }
            }
          }
        }
      },
      "team-generations": {
        "kind": "Panel",
        "spec": {
