      "path-traces": {
        "kind": "Panel",
        "spec": {
          "id": 12,
          "title": "Recent site-to-agent traces",
          "description": "Browser and site requests with trace links. Open a trace to follow Redis, orchestrator and specialist spans.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_traces}"
                      },
                      "spec": {
                        "queryType": "traceql",
                        "query": "{ resource.service.name = \"${svc_site_api}\" && name = \"POST\" }",
                        "limit": 50,
                        "tableType": "spans",
                        "spss": 3,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "enablePagination": false,
                "sortBy": [
                  {
                    "displayName": "time",
                    "desc": true
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": false,
                    "inspect": true
                  },
                  "color": {
                    "mode": "continuous-BlPu"
                  },
                  "unit": "short"
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Time"
                    },
                    "properties": [
                      {
                        "id": "custom.hidden",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "user_prompt"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Prompt"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "user.email"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Developer"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "duration"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Duration"
                      },
                      {
                        "id": "unit",
                        "value": "ns"
                      },
                      {
                        "id": "custom.width",
                        "value": 110
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "time"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Start"
                      },
                      {
                        "id": "custom.width",
                        "value": 190
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Span ID"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Trace"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "^(Spans traceIdHidden|traceIdHidden|Trace Service|traceService|Trace Name|traceName|Name|name|service\\.name|team\\.name|gen_ai\\.agent\\.name|gen_ai\\.operation\\.name)$"
                    },
                    "properties": [
                      {
                        "id": "custom.hidden",
                        "value": true
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "src-1": {
        "kind": "Panel",
