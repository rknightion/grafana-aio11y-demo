              }
            }
          }
        }
      },
      "red-edges": {
        "kind": "Panel",
        "spec": {
          "id": 34,
          "title": "Agent service graph edges / hour",
          "description": "Request throughput on observed service graph edges into the demo namespace, in calls per hour. Virtual user and external destinations are excluded.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(sum by(client,server)(rate(traces_service_graph_request_total{server_service_namespace=\"${prefix}\",client!=\"user\"}[$__rate_interval]))) * 3600",
                        "legendFormat": "{{client}} → {{server}}",
                        "range": true,
                        "instant": false,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
