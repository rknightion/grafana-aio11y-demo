      "red-p95": {
        "kind": "Panel",
        "spec": {
          "id": 33,
          "title": "Request path p95 by service",
          "description": "Native histogram of POST server span duration, grouped by agent service.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.95,sum by(service)(rate(traces_spanmetrics_latency{service_namespace=\"${prefix}\",span_kind=\"SPAN_KIND_SERVER\",span_name=\"POST\"}[5m])))",
                        "legendFormat": "{{service}}",
                        "range": true,
                        "instant": false,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
