                    "matcher": {
                      "id": "byRegexp",
                      "options": "^(Spans traceIdHidden|traceIdHidden|Trace Service|traceService|Trace Name|traceName|Name|name|service\\.name|team\\.name|gen_ai\\.agent\\.name|gen_ai\\.operation\\.name)$"
                    },
                    "properties": [
                      {
                        "id": "custom.hidden",
