{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "${dash_agents}"
  },
  "spec": {
    "title": "Observing an agentic app (${prefix})",
    "description": "The in-app agents: request path, model economics, tool use, online evaluations and guard outcomes.",
    "tags": [
      "${prefix}",
      "agents",
      "ai-observability"
    ],
    "editable": true,
    "liveNow": false,
    "preload": false,
    "cursorSync": "Crosshair",
    "timeSettings": {
      "from": "now-3h",
      "to": "now",
      "timezone": "browser",
      "autoRefresh": "1m"
    },
    "links": [
      {
        "title": "Agent Observability",
        "type": "link",
        "url": "/a/grafana-agento11y-app",
        "icon": "external link",
        "tooltip": "Agent conversations, generations, scores and explanations",
        "tags": [],
        "asDropdown": false,
        "targetBlank": true,
        "includeVars": false,
        "keepTime": true
      },
      {
        "title": "Application Observability",
        "type": "link",
        "url": "/a/grafana-app-observability-app",
        "icon": "external link",
        "tooltip": "Service RED and dependency graph",
        "tags": [],
        "asDropdown": false,
        "targetBlank": true,
        "includeVars": false,
        "keepTime": true
      }
    ],
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "variables": [
      {
        "kind": "CustomVariable",
        "spec": {
          "name": "trace_id",
          "label": "Conversation trace ID",
          "description": "Choose a trace from the conversation table to show its deduplicated generation cost.",
          "query": "",
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": true
        }
      }
    ],
    "elements": {
      "ov-requests": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Site API requests",
          "description": "POST requests to /api/picks.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "round(sum(increase(http_server_request_duration_seconds_count{service_namespace=\"${prefix}\",service_name=\"${svc_site_api}\",http_request_method=\"POST\"}[$__range])))",
                        "legendFormat": "{{service_name}} {{gen_ai_request_model}} {{gen_ai_token_type}} {{passed}} {{action}}",
                        "range": false,
                        "instant": true,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "wideLayout": true,
                "showPercentChange": false,
                "orientation": "auto",
                "text": {
                  "valueSize": 34
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  },
                  "noValue": "0",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      }
                    ]
                  },
                  "decimals": 2
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ov-generations": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Agent generations",
          "description": "Successful and failed model operations across agent roles.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "round(sum(increase(gen_ai_client_operation_duration_seconds_count{service_namespace=\"${prefix}\",service_name=~\"${agents_re}\",gen_ai_operation_name=\"generateText\"}[$__range])))",
                        "legendFormat": "{{service_name}} {{gen_ai_request_model}} {{gen_ai_token_type}} {{passed}} {{action}}",
                        "range": false,
                        "instant": true,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "wideLayout": true,
                "showPercentChange": false,
                "orientation": "auto",
                "text": {
                  "valueSize": 34
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  },
                  "noValue": "0",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      }
                    ]
                  },
                  "decimals": 2
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ov-input": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Input tokens",
          "description": "Input tokens from agent model calls.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "round(sum(increase(gen_ai_client_token_usage_sum{service_namespace=\"${prefix}\",service_name=~\"${agents_re}\",gen_ai_token_type=\"input\"}[$__range])))",
                        "legendFormat": "{{service_name}} {{gen_ai_request_model}} {{gen_ai_token_type}} {{passed}} {{action}}",
                        "range": false,
                        "instant": true,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "wideLayout": true,
                "showPercentChange": false,
                "orientation": "auto",
                "text": {
                  "valueSize": 34
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  },
                  "noValue": "0",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      }
                    ]
                  },
                  "decimals": 2
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ov-output": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Output tokens",
          "description": "Output tokens from agent model calls.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "round(sum(increase(gen_ai_client_token_usage_sum{service_namespace=\"${prefix}\",service_name=~\"${agents_re}\",gen_ai_token_type=\"output\"}[$__range])))",
                        "legendFormat": "{{service_name}} {{gen_ai_request_model}} {{gen_ai_token_type}} {{passed}} {{action}}",
                        "range": false,
                        "instant": true,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "wideLayout": true,
                "showPercentChange": false,
                "orientation": "auto",
                "text": {
                  "valueSize": 34
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  },
                  "noValue": "0",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      }
                    ]
                  },
                  "decimals": 2
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ov-agent-ops": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Generations by agent / hour",
          "description": "Generation throughput by agent, in operations per hour.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(sum by (service_name)(rate(gen_ai_client_operation_duration_seconds_count{service_namespace=\"${prefix}\",service_name=~\"${agents_re}\",gen_ai_operation_name=\"generateText\"}[$__rate_interval]))) * 3600",
                        "legendFormat": "{{service_name}}",
                        "range": true,
                        "instant": false,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "5m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "lastNotNull"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "drawStyle": "bars",
                    "lineWidth": 1,
                    "fillOpacity": 80,
                    "gradientMode": "none",
                    "showPoints": "never",
                    "pointSize": 5,
                    "barAlignment": 0,
                    "spanNulls": false,
                    "axisSoftMin": 0,
                    "stacking": {
                      "mode": "normal",
                      "group": "A"
                    }
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "decimals": 3
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ov-site-status": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Site API responses / hour",
          "description": "POST response throughput by HTTP status, in responses per hour.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(sum by (http_response_status_code)(rate(http_server_request_duration_seconds_count{service_namespace=\"${prefix}\",service_name=\"${svc_site_api}\",http_request_method=\"POST\"}[$__rate_interval]))) * 3600",
                        "legendFormat": "HTTP {{http_response_status_code}}",
                        "range": true,
                        "instant": false,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "5m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "lastNotNull"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "drawStyle": "bars",
                    "lineWidth": 1,
                    "fillOpacity": 80,
                    "gradientMode": "none",
                    "showPoints": "never",
                    "pointSize": 5,
                    "barAlignment": 0,
                    "spanNulls": false,
                    "axisSoftMin": 0,
                    "stacking": {
                      "mode": "normal",
                      "group": "A"
                    }
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "decimals": 3
                },
                "overrides": []
              }
            }
          }
        }
      },
      "src-0": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "",
          "description": "",
          "links": [],
          "transparent": true,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "**Source:** Mimir HTTP and GenAI counters from `${svc_site_api}` and the agents; Tempo spans link browser, site API and agents. All panels use the selected time range.",
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false,
                  "showMiniMap": false
                }
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "path-browser": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Browser POSTs",
          "description": "Faro browser fetch spans reaching the site API.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_traces}"
                      },
                      "spec": {
                        "queryType": "traceql",
                        "query": "{ resource.service.name = \"${svc_site_web}\" && name = \"POST\" } | count_over_time()",
                        "limit": 50,
                        "tableType": "spans",
                        "spss": 3,
                        "refId": "A",
                        "legendFormat": "Browser POST"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "5m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "sum"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "drawStyle": "bars",
                    "lineWidth": 1,
                    "fillOpacity": 80,
                    "gradientMode": "none",
                    "showPoints": "never",
                    "pointSize": 5,
                    "barAlignment": 0,
                    "spanNulls": false,
                    "axisSoftMin": 0,
                    "stacking": {
                      "mode": "normal",
                      "group": "A"
                    }
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "decimals": 3
                },
                "overrides": []
              }
            }
          }
        }
      },
      "path-api": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Site API POSTs",
          "description": "Incoming POST requests to the site API.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "round(sum(increase(http_server_request_duration_seconds_count{service_namespace=\"${prefix}\",service_name=\"${svc_site_api}\",http_request_method=\"POST\"}[$__range])))",
                        "legendFormat": "{{service_name}} {{gen_ai_request_model}} {{gen_ai_token_type}} {{passed}} {{action}}",
                        "range": false,
                        "instant": true,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "wideLayout": true,
                "showPercentChange": false,
                "orientation": "auto",
                "text": {
                  "valueSize": 34
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  },
                  "noValue": "0",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      }
                    ]
                  },
                  "decimals": 2
                },
                "overrides": []
              }
            }
          }
        }
      },
      "path-api-p95": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Site API p95",
          "description": "p95 HTTP server duration for the site API.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.95,sum by (le)(rate(http_server_request_duration_seconds_bucket{service_namespace=\"${prefix}\",service_name=\"${svc_site_api}\",http_request_method=\"POST\"}[5m])))",
                        "legendFormat": "{{service_name}} {{gen_ai_request_model}} {{gen_ai_token_type}} {{passed}} {{action}}",
                        "range": true,
                        "instant": false,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "wideLayout": true,
                "showPercentChange": false,
                "orientation": "auto",
                "text": {
                  "valueSize": 34
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  },
                  "noValue": "0",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      }
                    ]
                  },
                  "decimals": 2
                },
                "overrides": []
              }
            }
          }
        }
      },
      "path-service": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Agent calls by role / hour",
          "description": "Generation throughput by agent role, in calls per hour.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(sum by (service_name)(rate(gen_ai_client_operation_duration_seconds_count{service_namespace=\"${prefix}\",service_name=~\"${agents_re}\",gen_ai_operation_name=\"generateText\"}[$__rate_interval]))) * 3600",
                        "legendFormat": "{{service_name}}",
                        "range": true,
                        "instant": false,
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
