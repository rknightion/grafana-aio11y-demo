      "red-requests": {
        "kind": "Panel",
        "spec": {
          "id": 32,
          "title": "Request path POST calls / hour",
          "description": "POST server span throughput through the agent request path, in calls per hour. HTTP health GETs are excluded.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
