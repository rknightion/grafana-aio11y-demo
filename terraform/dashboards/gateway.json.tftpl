      "gs-intro": {
        "kind": "Panel",
        "spec": {
          "id": 196,
          "title": "",
          "description": "",
          "links": [],
          "transparent": true,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "**Source: the gateway's own spend store (Postgres on the agent host, reached through Private Data source Connect, datasource `${ds_spend}`).** After each response the gateway's usage meter prices the tokens and adds the cost to per-developer daily, weekly and monthly counters (`spend`, in cents). Caps live in `spend_limits` (set through the gateway admin API when the demo starts; a developer over any cap gets `429 billing_error`), and every admin change is recorded in `admin_audit`. These are the gateway's USD estimates, a circuit breaker rather than an invoice. Developer identity is the IdP subject, joined to `principal_emails` for the email and groups."
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "gs-today": {
        "kind": "Panel",
        "spec": {
          "id": 197,
          "title": "Spend today",
          "description": "SUM(cents)/100 for the current period row (to_char(now() AT TIME ZONE 'UTC','YYYY-MM-DD')).",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_spend}"
                      },
                      "spec": {
                        "refId": "A",
                        "rawSql": "SELECT COALESCE(SUM(cents),0)/100.0 AS usd FROM spend WHERE period = to_char(now() AT TIME ZONE 'UTC','YYYY-MM-DD')",
                        "format": "table",
                        "rawQuery": true,
                        "editorMode": "code"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "currencyUSD",
                  "decimals": 2,
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
