{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "${dash_gateway}"
  },
  "spec": {
    "title": "Observing the Claude apps gateway (${prefix})",
    "description": "Only data the Claude apps gateway itself produces: audit log, operational logs, its spend store, and recording rules derived from them. No Claude Code OTel, no Bedrock.",
    "tags": [
      "${prefix}",
      "gateway",
      "ai-observability"
    ],
    "editable": true,
    "liveNow": false,
    "preload": false,
    "cursorSync": "Crosshair",
    "timeSettings": {
      "from": "now-3h",
      "to": "now",
      "autoRefresh": "1m",
      "timezone": "browser",
      "autoRefreshIntervals": [
        "30s",
        "1m",
        "5m",
        "15m",
        "1h"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "links": [
      {
        "title": "Observing Claude Code",
        "type": "link",
        "url": "/d/${dash_claude_code}",
        "icon": "external link",
        "tooltip": "",
        "tags": [],
        "asDropdown": false,
        "targetBlank": false,
        "includeVars": false,
        "keepTime": true
      },
      {
        "title": "Observing Bedrock",
        "type": "link",
        "url": "/d/${dash_bedrock}",
        "icon": "external link",
        "tooltip": "",
        "tags": [],
        "asDropdown": false,
        "targetBlank": false,
        "includeVars": false,
        "keepTime": true
      }
    ],
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "variables": [],
    "elements": {
      "ga-intro": {
        "kind": "Panel",
        "spec": {
          "id": 178,
          "title": "",
          "description": "",
          "links": [],
          "transparent": true,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "**Source: the Claude apps gateway's own audit log only** (one JSON line per event, with an `evt` field, on the gateway container's output on the agent host, shipped to Loki by the host Alloy as `service_name=${svc_gateway}`). Nothing here needs telemetry on the developer containers: every developer signs in through the gateway, and every model call passes through it. Events: `device.authorize` / `device.verify` / `session.mint` (sign-in with the IdP), `managed.serve` (the gateway pushing managed settings, including telemetry env and `managedMcpServers`), `inference` (every `/v1/messages` call with email, model, upstream, status and latency) and `config.load`. The gateway exposes no Prometheus metrics, so this tab is logs only. It never logs prompt content."
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "ga-devs": {
        "kind": "Panel",
        "spec": {
          "id": 179,
          "title": "Developers with a session",
          "description": "Distinct emails with a session.mint or inference event.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "count(sum by (email) (count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=~\"session.mint|session.refresh|inference\" [$__range])))",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "blue"
                  },
                  "noValue": "0"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-infer": {
        "kind": "Panel",
        "spec": {
          "id": 180,
          "title": "Inference requests",
          "description": "inference events: every model call the gateway relayed.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum(count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=\"inference\" [$__range]))",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  },
                  "noValue": "0"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-errors": {
        "kind": "Panel",
        "spec": {
          "id": 181,
          "title": "Non-2xx inference",
          "description": "inference events with status >= 400 (501 is Bedrock not supporting /v1/messages/count_tokens).",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum(count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=\"inference\" | status >= 400 [$__range])) or vector(0)",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "orange"
                  },
                  "noValue": "0"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-denied": {
        "kind": "Panel",
        "spec": {
          "id": 182,
          "title": "Denials",
          "description": "auth.denied, access.denied, spend.blocked and admin.denied.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum(count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=~\"auth.denied|access.denied|spend.blocked|admin.denied\" [$__range])) or vector(0)",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "red"
                  },
                  "noValue": "0"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-managed": {
        "kind": "Panel",
        "spec": {
          "id": 183,
          "title": "Managed settings served",
          "description": "managed.serve: the gateway pushing policy (telemetry env, managed MCP servers) to a signed-in client.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum(count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=\"managed.serve\" [$__range])) or vector(0)",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "purple"
                  },
                  "noValue": "0"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-p95": {
        "kind": "Panel",
        "spec": {
          "id": 184,
          "title": "Inference latency p95",
          "description": "p95 of the gateway-measured ms for /v1/messages.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "quantile_over_time(0.95, {service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=\"inference\" | path=\"/v1/messages\" | unwrap ms [$__range]) by ()",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "text"
                  },
                  "noValue": "-"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-events": {
        "kind": "Panel",
        "spec": {
          "id": 185,
          "title": "Audit events over time",
          "description": "Every gateway audit event by type.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (evt) (count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json [$__auto]))",
                        "queryType": "range",
                        "refId": "A",
                        "legendFormat": "{{evt}}"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "sum"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "drawStyle": "bars",
                    "stacking": {
                      "mode": "normal"
                    },
                    "fillOpacity": 80
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-upstream": {
        "kind": "Panel",
        "spec": {
          "id": 186,
          "title": "Upstream split",
          "description": "inference events by upstream route and status.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (upstream, status) (count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=\"inference\" [$__range]))",
                        "queryType": "instant",
                        "refId": "A",
                        "legendFormat": "{{upstream}} {{status}}"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "piechart",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "values": [
                    "value",
                    "percent"
                  ]
                },
                "pieType": "donut",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-model-rate": {
        "kind": "Panel",
        "spec": {
          "id": 187,
          "title": "Inference rate by model",
          "description": "Requests per interval by model name the client asked for.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (model) (count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=\"inference\" [$__auto]))",
                        "queryType": "range",
                        "refId": "A",
                        "legendFormat": "{{model}}"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "sum"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "drawStyle": "bars",
                    "stacking": {
                      "mode": "normal"
                    },
                    "fillOpacity": 80
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-lat": {
        "kind": "Panel",
        "spec": {
          "id": 188,
          "title": "Latency p95 by model",
          "description": "Gateway-measured request duration for /v1/messages (includes model time; streams are timed to completion).",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "quantile_over_time(0.95, {service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=\"inference\" | path=\"/v1/messages\" | unwrap ms [$__auto]) by (model)",
                        "queryType": "range",
                        "refId": "A",
                        "legendFormat": "{{model}}"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "mean",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-dev-model": {
        "kind": "Panel",
        "spec": {
          "id": 189,
          "title": "Inference by developer, model and status",
          "description": "Who called which model, and how it went. Identity is the IdP email on the gateway session.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (email, model, path, status) (count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=\"inference\" [$__range]))",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [
                {
                  "id": "reduce",
                  "options": {
                    "reducers": [
                      "lastNotNull"
                    ],
                    "labelsToFields": true
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true,
                "sortBy": [
                  {
                    "displayName": "Value #A",
                    "desc": true
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-signins": {
        "kind": "Panel",
        "spec": {
          "id": 190,
          "title": "Sign-ins by developer",
          "description": "session.mint / session.refresh and the device flow, by email and result.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (evt, email, result) (count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=~\"device.authorize|device.verify|session.mint|session.refresh\" [$__range]))",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [
                {
                  "id": "reduce",
                  "options": {
                    "reducers": [
                      "lastNotNull"
                    ],
                    "labelsToFields": true
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-policy": {
        "kind": "Panel",
        "spec": {
          "id": 191,
          "title": "Policy pushes (managed.serve)",
          "description": "Which developer received which managed-settings version (checksum). A new checksum after a policy change proves the push reached the client.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (email, policy_index, checksum) (count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=\"managed.serve\" [$__range]))",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [
                {
                  "id": "reduce",
                  "options": {
                    "reducers": [
                      "lastNotNull"
                    ],
                    "labelsToFields": true
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-ips": {
        "kind": "Panel",
        "spec": {
          "id": 192,
          "title": "Client IPs",
          "description": "Where sign-ins and device flows came from (client_ip on auth events). The developer containers share the agent host's address.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (client_ip, evt, result) (count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=~\"device.authorize|device.verify|session.mint|session.refresh|auth.denied\" [$__range]))",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [
                {
                  "id": "reduce",
                  "options": {
                    "reducers": [
                      "lastNotNull"
                    ],
                    "labelsToFields": true
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-config": {
        "kind": "Panel",
        "spec": {
          "id": 193,
          "title": "Gateway config loads",
          "description": "config.load: each gateway.yaml the gateway loaded, by hash. A rollout shows as a new sha256.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "sum by (sha256, path) (count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |= \"\\\"evt\\\"\" | json | evt=\"config.load\" [$__range]))",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [
                {
                  "id": "reduce",
                  "options": {
                    "reducers": [
                      "lastNotNull"
                    ],
                    "labelsToFields": true
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ga-errlog": {
        "kind": "Panel",
        "spec": {
          "id": 194,
          "title": "Errors and denials",
          "description": "Non-2xx inference, denials and the gateway's own warn lines (upstream stream errors, 501s).",
