      "gs-per-dev": {
        "kind": "Panel",
        "spec": {
          "id": 202,
          "title": "Spend per developer (today / week / month)",
          "description": "spend joined to principal_emails. USD = cents / 100.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_spend}"
                      },
                      "spec": {
                        "refId": "A",
                        "rawSql": "SELECT COALESCE(e.email, s.principal) AS developer, e.name, e.groups::text AS groups,\n SUM(CASE WHEN s.period = to_char(now() AT TIME ZONE 'UTC','YYYY-MM-DD') THEN s.cents ELSE 0 END)/100.0 AS today_usd,\n SUM(CASE WHEN s.period = to_char(now() AT TIME ZONE 'UTC','IYYY-\"W\"IW') THEN s.cents ELSE 0 END)/100.0 AS week_usd,\n SUM(CASE WHEN s.period = to_char(now() AT TIME ZONE 'UTC','YYYY-MM') THEN s.cents ELSE 0 END)/100.0 AS month_usd,\n MAX(s.updated_at) AS last_metered\nFROM spend s LEFT JOIN principal_emails e ON e.principal = s.principal\nGROUP BY 1,2,3 ORDER BY month_usd DESC",
                        "format": "table",
                        "rawQuery": true,
                        "editorMode": "code"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none"
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".*_usd"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "currencyUSD"
                      },
                      {
                        "id": "decimals",
                        "value": 2
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "gs-month-bar": {
        "kind": "Panel",
        "spec": {
          "id": 203,
          "title": "This month by developer",
          "description": "Monthly counter per developer.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_spend}"
                      },
                      "spec": {
                        "refId": "A",
                        "rawSql": "SELECT COALESCE(e.email, s.principal) AS developer, SUM(s.cents)/100.0 AS usd FROM spend s LEFT JOIN principal_emails e ON e.principal = s.principal WHERE s.period = to_char(now() AT TIME ZONE 'UTC','YYYY-MM') GROUP BY 1 ORDER BY 2 DESC",
                        "format": "table",
                        "rawQuery": true,
                        "editorMode": "code"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "",
            "spec": {
              "options": {
                "orientation": "horizontal",
                "displayMode": "gradient",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": true
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "currencyUSD",
                  "decimals": 2
                },
                "overrides": []
              }
            }
          }
        }
      },
      "gs-daily": {
        "kind": "Panel",
        "spec": {
          "id": 204,
          "title": "Daily spend history",
          "description": "One point per day from the daily counters (period = YYYY-MM-DD).",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_spend}"
                      },
                      "spec": {
                        "refId": "A",
                        "rawSql": "SELECT to_date(s.period,'YYYY-MM-DD')::timestamptz AS time, COALESCE(e.email, s.principal) AS developer, SUM(s.cents)/100.0 AS usd\nFROM spend s LEFT JOIN principal_emails e ON e.principal = s.principal\nWHERE s.period ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'\nGROUP BY 1,2 ORDER BY 1",
                        "format": "time_series",
                        "rawQuery": true,
                        "editorMode": "code"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "sum"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "currencyUSD",
                  "decimals": 2,
                  "custom": {
                    "drawStyle": "bars",
                    "stacking": {
                      "mode": "normal"
                    },
                    "fillOpacity": 80
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "gs-limits": {
        "kind": "Panel",
        "spec": {
          "id": 205,
          "title": "Caps vs spend",
          "description": "Each configured cap with the current period-to-date spend of the principals it covers (user caps join directly; group and org caps are per-seat defaults, shown against the highest spender). Empty until a cap is set via POST /v1/organizations/spend_limits.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_spend}"
                      },
                      "spec": {
                        "refId": "A",
                        "rawSql": "WITH cur AS (\n SELECT s.principal, e.email, e.groups, CASE WHEN s.period = to_char(now() AT TIME ZONE 'UTC','YYYY-MM-DD') THEN 'daily' WHEN s.period = to_char(now() AT TIME ZONE 'UTC','IYYY-\"W\"IW') THEN 'weekly' WHEN s.period = to_char(now() AT TIME ZONE 'UTC','YYYY-MM') THEN 'monthly' END AS period, s.cents\n FROM spend s LEFT JOIN principal_emails e ON e.principal = s.principal WHERE s.period IN (to_char(now() AT TIME ZONE 'UTC','YYYY-MM-DD'),to_char(now() AT TIME ZONE 'UTC','IYYY-\"W\"IW'),to_char(now() AT TIME ZONE 'UTC','YYYY-MM')))\nSELECT l.scope_type, l.scope_id, l.period, l.amount/100.0 AS cap_usd,\n COALESCE(MAX(c.cents),0)/100.0 AS top_spend_usd,\n CASE WHEN l.amount > 0 THEN 100.0*COALESCE(MAX(c.cents),0)/l.amount END AS pct_of_cap\nFROM spend_limits l LEFT JOIN cur c ON c.period = l.period AND (l.scope_type = 'organization'\n  OR (l.scope_type = 'user' AND (c.principal = l.scope_id OR c.email = l.scope_id))\n  OR (l.scope_type = 'rbac_group' AND c.groups ? l.scope_id))\nGROUP BY l.scope_type, l.scope_id, l.period, l.amount ORDER BY pct_of_cap DESC NULLS LAST",
                        "format": "table",
                        "rawQuery": true,
                        "editorMode": "code"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "noValue": "No caps configured"
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".*_usd"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "currencyUSD"
                      },
                      {
                        "id": "decimals",
                        "value": 2
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "pct_of_cap"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "percent"
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "gauge",
                          "mode": "basic"
                        }
                      },
                      {
                        "id": "max",
                        "value": 100
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "gs-audit": {
        "kind": "Panel",
        "spec": {
          "id": 206,
          "title": "Admin audit",
          "description": "admin_audit: who changed a cap or setting, when, and why. Empty until an admin uses the admin API.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_spend}"
                      },
                      "spec": {
                        "refId": "A",
                        "rawSql": "SELECT at AS time, actor, action, target, reason, before::text AS before, after::text AS after FROM admin_audit ORDER BY at DESC LIMIT 200",
                        "format": "table",
                        "rawQuery": true,
                        "editorMode": "code"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "noValue": "No admin changes yet"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "gs-rec": {
        "kind": "Panel",
        "spec": {
          "id": 207,
          "title": "Spend over time (recording rule ${metric_prefix}_gateway_spend_usd)",
          "description": "A Grafana-managed recording rule that queries this same Postgres spend store and writes ${metric_prefix}_gateway_spend_usd to Prometheus, so spend has history and can drive alerts. No custom exporter.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (email, period_kind) (${metric_prefix}_gateway_spend_usd)",
                        "range": true,
                        "instant": false,
                        "refId": "A",
                        "legendFormat": "{{email}} {{period_kind}}"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": [
                    "mean",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "currencyUSD",
                  "decimals": 2
                },
                "overrides": []
              }
            }
          }
        }
      },
