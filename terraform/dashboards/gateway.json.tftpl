                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "expr": "{service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} |~ \"\\\"status\\\":[45]|denied|blocked| warn | error \"",
                        "queryType": "range",
                        "refId": "A"
