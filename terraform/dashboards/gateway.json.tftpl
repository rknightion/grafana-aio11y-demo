      "op-warn": {
        "kind": "Panel",
        "spec": {
          "id": 1040,
          "title": "Gateway warn lines by message",
          "description": "Non-audit gateway lines, grouped by message with ids stripped.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (msg) (count_over_time({service_namespace=\"${prefix}\", service_name=\"${svc_gateway}\"} != \"\\\"evt\\\"\" | regexp \"(?P<lvl>info|warn|error) (?P<msg>[^=]+?)( request_id=.*)?$\" [$__range]))",
                        "legendFormat": "{{msg}}",
                        "queryType": "instant",
                        "refId": "A"
                      }
                    }
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "reduce",
                  "spec": {
                    "id": "reduce",
                    "options": {
                      "reducers": [
                        "lastNotNull"
                      ],
                      "mode": "seriesToRows"
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
